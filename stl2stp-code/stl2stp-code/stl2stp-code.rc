IDR_MAINFRAME ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY,CONTROL
    "O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
    "S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,           VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,           VIRTKEY,CONTROL
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
    VK_INSERT,      ID_EDIT_COPY,          VIRTKEY,CONTROL
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY
    VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
END

// 【新 UI P2·SDI 化阶段 1.2】SDI 主框架由文档模板 LoadFrame(IDR_stl2stpcodeTYPE)
// 创建——130 原无加速键表（MDI 时代快捷键由主框架 128 承载），不补齐则
// Ctrl+N/O/S 等全部静默失效。内容照抄 IDR_MAINFRAME 键表（设计定稿 4.2.2(d)）。
IDR_stl2stpcodeTYPE ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY,CONTROL
    "O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
    "S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,           VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,           VIRTKEY,CONTROL
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
    VK_INSERT,      ID_EDIT_COPY,          VIRTKEY,CONTROL
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY
    VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
END




/////////////////////////////////////////////////////////////////////////////
//
// 对话框
//

IDD_ABOUTBOX DIALOGEX 0, 0, 171, 72
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 STL2STP"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,20,20
    LTEXT           "STL2STP（正式版），v1.0.2",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2017",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,114,51,50,14,WS_GROUP
END

// 复刻原版资源 333：网格简化比例输入对话框（黄色 J 按钮触发）
// （新 UI 增补 IDC_SIMP_ESTIMATE：随输入实时显示预计简化后面数）
IDD_MESH_SIMPLIFY DIALOGEX 0, 0, 278, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "请输入网格简化比例"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,161,65,50,14
    PUSHBUTTON      "取消",IDCANCEL,215,65,50,14
    LTEXT           "请输入网格简化比例（输入范围：0-1。简化比例越小，得到的STL模型中的面片数量越少）：",IDC_STATIC,19,16,229,25
    EDITTEXT        IDC_SIMP_RATIO,94,38,77,15,ES_CENTER | ES_AUTOHSCROLL
    LTEXT           "预计简化后的三角面数：—",IDC_SIMP_ESTIMATE,19,56,229,9
END

// 新 UI 增补：导出进度对话框（替代原版冻结式沙漏光标）——
// 分阶段进度 + 当前阶段说明 + 可取消（取消发生在写盘前，不产生半成品文件）
IDD_EXPORT_PROGRESS DIALOGEX 0, 0, 244, 82
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
CAPTION "正在转换"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "正在准备…",IDC_EXPORT_STAGE,14,14,216,12
    CONTROL         "",IDC_EXPORT_PROGRESS_BAR,"msctls_progress32",WS_VISIBLE | 0x1,14,34,216,13
    PUSHBUTTON      "取消",IDCANCEL,97,58,50,14
END



