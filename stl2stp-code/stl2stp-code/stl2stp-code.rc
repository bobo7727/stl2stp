#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "有乌鸦的麦田"
            VALUE "FileDescription", "STL2STP"
            VALUE "FileVersion",     "1.0.2"
            VALUE "InternalName",    "STL2STP.exe"
            VALUE "LegalCopyright", "(C) <BIT>。保留所有权利。"
            VALUE "OriginalFilename","STL2STP.exe"
            VALUE "ProductName", "有乌鸦的麦田"
            VALUE "ProductVersion",  "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

