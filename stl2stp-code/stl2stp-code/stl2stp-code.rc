IDR_MAINFRAME TOOLBAR 16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END

// 原版资源 129 的工具栏按钮表（原版子框架第一个可见工具栏行）：
// 首按钮 0xE000=AFX_IDS_APP_TITLE 是无命令处理器的装饰按钮（原版如此）
IDR_MAINFRAME_256 TOOLBAR 16, 15
BEGIN
    BUTTON      AFX_IDS_APP_TITLE
    BUTTON      ID_FILE_NEW
    SEPARATOR
    BUTTON      ID_IMPORT_STL_MODEL
    BUTTON      ID_EXPORT_IGES
    BUTTON      ID_EXPORT_STEP
    BUTTON      ID_MESH_SIMPLIFY
END

// 子框架工具栏（新 UI：原版 3D Viewer(32785) 与 Ray Tracing(324) 两行合并为一行；
// 位图 child_bar_merged.bmp 由两块取证位图按按钮序合成——同时修正 P0 移除
// 6 个死按钮后的按钮-位图索引错位（MFC 分隔符不占位图槽，LoadToolBarEx 源码取证）。
// 【方案 A（WYSIWYG）】操纵器 附加/取消 两按钮移除——视口姿态编辑不被导出尊重。
// 注：位图尾部的 2 个多余图像槽闲置无害（尾部删除不引起索引错位）
IDR_VIEW_TOOLBAR TOOLBAR 16, 15
BEGIN
    BUTTON      ID_VIEW_FITALL
    SEPARATOR
    BUTTON      ID_VIEW_PROJ_BACK
    BUTTON      ID_VIEW_PROJ_TOP
    BUTTON      ID_VIEW_PROJ_LEFT
    BUTTON      ID_VIEW_PROJ_FRONT
    BUTTON      ID_VIEW_PROJ_RIGHT
    BUTTON      ID_VIEW_PROJ_BOTTOM
    BUTTON      ID_VIEW_PROJ_AXO
    BUTTON      ID_VIEW_RESET
    BUTTON      ID_HLR_OFF
    BUTTON      ID_HLR_ON
    SEPARATOR
    BUTTON      ID_VIEW_RAYTRACING
    BUTTON      ID_VIEW_SHADOW
    BUTTON      ID_VIEW_REFLECTION
    BUTTON      ID_VIEW_ANTIALIASING
    BUTTON      ID_VIEW_GRID
END


IDR_SORT TOOLBAR 16, 15
BEGIN
    BUTTON      ID_SORT_MENU
    BUTTON      ID_NEW_FOLDER
END

IDR_EXPLORER TOOLBAR 16, 15
BEGIN
    BUTTON      ID_PROPERTIES
END

IDR_MENU_IMAGES TOOLBAR 16, 15
BEGIN
    BUTTON      ID_WINDOW_MANAGER
    SEPARATOR
