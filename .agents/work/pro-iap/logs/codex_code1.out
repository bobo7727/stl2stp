     1	import Foundation
     2	import StoreKit
     3	
     4	/// Native StoreKit 2 backend (tip + Pro). It is the only transaction listener /
     5	/// finisher in the iOS app (the Dart `in_app_purchase` backend is not used on iOS).
     6	///
     7	/// - Tip (`com.stl2stp.app.tip.*`, consumable): verified -> finish -> thank-you.
     8	///   Nothing is granted, so no delivery log is kept; `finish()` is idempotent.
     9	/// - Pro (`com.stl2stp.app.pro`, non-consumable): the ONLY source of truth is
    10	///   `Transaction.currentEntitlements` (verified, right product/type/bundle,
    11	///   not revoked). It is recomputed at start, on every Pro update (refunds
    12	///   arrive here), after a purchase and after an explicit restore. There is no
    13	///   ledger: Apple's answer replaces the Dart-side cache.
    14	actor StoreCoordinator {
    15	  static let shared = StoreCoordinator()
    16	
    17	  static let proID = "com.stl2stp.app.pro"
    18	  /// Only the first-release tip is queried and shown. Replay handles every id
    19	  /// here so an unfinished transaction is never left hanging.
    20	  static let tipIDs: Set<String> = ["com.stl2stp.app.tip.small"]
    21	
    22	  private var begun = false
    23	  private var buying = false
    24	  /// Last computed Pro entitlement.
    25	  private var proActive = false
    26	  private var handledTips = Set<String>()
    27	  private var announcedUnverified = Set<UInt64>()
    28	  private var updatesTask: Task<Void, Never>?
    29	  private var sink: (@Sendable ([String: Any]) -> Void)?
    30	
    31	  func setSink(_ sink: (@Sendable ([String: Any]) -> Void)?) { self.sink = sink }
    32	
    33	  /// Starts the single Transaction.updates listener and replays unfinished
    34	  /// transactions. Safe to call many times; called at launch.
    35	  func begin() {
    36	    guard !begun else { return }
    37	    begun = true
    38	    updatesTask = Task { [weak self] in
    39	      for await result in Transaction.updates {
    40	        await self?.handle(result)
    41	      }
    42	    }
    43	    Task { [weak self] in
    44	      for await result in Transaction.unfinished {
    45	        await self?.handle(result)
    46	      }
    47	    }
    48	  }
    49	
    50	  /// Dart start-up: begin listening, then compute Pro from Apple's entitlements.
    51	  func start() async -> [String: Any] {
    52	    begin()
    53	    await recomputePro()
    54	    return proEvent()
    55	  }
    56	
    57	  func loadProducts() async -> [String: Any] {
    58	    let canPay = AppStore.canMakePayments
    59	    do {
    60	      let products = try await Product.products(for: Self.tipIDs.union([Self.proID]))
    61	      func info(_ p: Product) -> [String: String] {
    62	        ["id": p.id, "title": p.displayName, "description": p.description, "price": p.displayPrice]
    63	      }
    64	      let tips = products.filter { $0.type == .consumable && Self.tipIDs.contains($0.id) }.map(info)
    65	      var result: [String: Any] = ["canPay": canPay, "tips": tips]
    66	      if let pro = products.first(where: { $0.id == Self.proID && $0.type == .nonConsumable }) {
    67	        result["pro"] = info(pro)
    68	      }
    69	      return result
    70	    } catch {
    71	      return ["canPay": canPay, "tips": [[String: String]](), "error": String(describing: error)]
    72	    }
    73	  }
    74	
    75	  /// Explicit restore (the only place AppStore.sync is called: it may prompt for sign-in).
    76	  func restore() async -> [String: Any] {
    77	    do {
    78	      try await AppStore.sync()
    79	    } catch {
    80	      // Sync failed or the user cancelled sign-in: keep whatever we had.
    81	      return ["outcome": "failed", "message": String(describing: error)]
    82	    }
    83	    await recomputePro()
    84	    return ["outcome": proActive ? "restored" : "nothingToRestore", "pro": proActive]
    85	  }
    86	
    87	  /// Foreground refresh: reads on-device entitlements only (no sync prompt).
    88	  func refresh() async -> [String: Any] {
    89	    await recomputePro()
    90	    return proEvent()
    91	  }
    92	
    93	  private func proEvent() -> [String: Any] { ["type": "pro", "pro": proActive] }
    94	
    95	  /// currentEntitlements is the single source of truth for Pro.
    96	  private func recomputePro() async {
    97	    var active = false
    98	    for await result in Transaction.currentEntitlements {
    99	      guard case .verified(let t) = result,
   100	        ProEntitlement.grants(
   101	          productID: t.productID, isNonConsumable: t.productType == .nonConsumable,
   102	          bundleID: t.appBundleID, expectedBundleID: Bundle.main.bundleIdentifier, revoked: t.revocationDate != nil)
   103	      else { continue }
   104	      active = true
   105	    }
   106	    let changed = active != proActive
   107	    proActive = active
   108	    if changed { emit(proEvent()) }
   109	  }
   110	
   111	  func buyTip(productId: String) async -> [String: Any] {
   112	    guard Self.tipIDs.contains(productId) else { return ["outcome": "unavailable"] }
   113	    return await purchase(productId, type: .consumable, expect: .tip)
   114	  }
   115	
   116	  func buyPro() async -> [String: Any] {
   117	    await purchase(Self.proID, type: .nonConsumable, expect: .pro)
   118	  }
   119	
   120	  /// One purchase at a time across tip and Pro (never two purchase sheets).
   121	  private func purchase(_ productId: String, type: Product.ProductType, expect: Handled) async -> [String: Any] {
   122	    guard !buying else { return ["outcome": "busy"] }
   123	    buying = true
   124	    defer { buying = false }
   125	    do {
   126	      guard let product = try await Product.products(for: [productId]).first, product.type == type else {
   127	        return ["outcome": "unavailable"]
   128	      }
   129	      switch try await product.purchase() {
   130	      case .success(let verification):
   131	        let handled = await handle(verification, announce: false)
   132	        if handled == expect { return ["outcome": "success"] }
   133	        if handled == .unverified { return ["outcome": "unverified"] }
   134	        return ["outcome": "failed", "message": "unrecognised transaction"]
   135	      case .userCancelled:
   136	        return ["outcome": "cancelled"]
   137	      case .pending:
   138	        return ["outcome": "pending"]
   139	      @unknown default:
   140	        return ["outcome": "failed", "message": "unknown purchase result"]
   141	      }
   142	    } catch {
   143	      if let e = error as? StoreKitError, case .userCancelled = e { return ["outcome": "cancelled"] }
   144	      return ["outcome": "failed", "message": String(describing: error)]
   145	    }
   146	  }
   147	
   148	  enum Handled { case tip, pro, unverified, ignored }
   149	
   150	  @discardableResult
   151	  private func handle(_ result: VerificationResult<Transaction>, announce: Bool = true) async -> Handled {
   152	    guard case .verified(let t) = result else {
   153	      // Never grant, never finish. Only tell the user when it was a tip
   154	      // (an unverified Pro transaction simply never becomes an entitlement).
   155	      if announce, case .unverified(let unverifiedTx, _) = result, Self.tipIDs.contains(unverifiedTx.productID),
   156	        announcedUnverified.insert(unverifiedTx.id).inserted {
   157	        emit(["type": "tip", "status": "unverified"])
   158	      }
   159	      return .unverified
   160	    }
   161	    guard t.appBundleID == Bundle.main.bundleIdentifier else { return .ignored }
   162	    if t.productID == Self.proID {
   163	      guard t.productType == .nonConsumable else { return .ignored }
   164	      // Recompute first (a refund/revocation arrives here too), then finish.
   165	      await recomputePro()
   166	      await t.finish()
   167	      return .pro
   168	    }
   169	    if Self.tipIDs.contains(t.productID) {
   170	      guard t.productType == .consumable else { return .ignored }
   171	      let first = handledTips.insert(String(t.id)).inserted
   172	      await t.finish()
   173	      // A refunded tip is finished silently; it never earned a thank-you.
   174	      if announce && first && t.revocationDate == nil { emit(["type": "tip", "status": "thanks"]) }
   175	      return .tip
   176	    }
   177	    return .ignored
   178	  }
   179	
   180	  private func emit(_ event: [String: Any]) { sink?(event) }
   181	}
