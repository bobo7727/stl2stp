    88	              title: '${pro['title'] ?? ''}',
    89	              description: '${pro['description'] ?? ''}',
    90	              priceLabel: pro['price'] as String)
    91	          : null;
    92	      _load = canPay && list.isNotEmpty ? TipLoad.ready : TipLoad.unavailable;
    93	    } catch (_) {
    94	      _products = const [];
    95	      _pro = null;
    96	      _load = TipLoad.unavailable;
    97	    }
    98	    notifyListeners();
    99	  }
   100	
   101	  @override
   102	  Future<TipResult> buyTip(String productId) async {
   103	    if (_buying) return const TipResult(TipOutcome.busy);
   104	    _buying = true;
   105	    try {
   106	      final r = await _method.invokeMapMethod<String, Object?>('buyTip', {'productId': productId});
   107	      final msg = r?['message'] as String?;
   108	      return switch (r?['outcome']) {
   109	        'success' => const TipResult(TipOutcome.thanks),
   110	        'cancelled' => const TipResult(TipOutcome.cancelled),
   111	        'pending' => const TipResult(TipOutcome.pending),
   112	        'unverified' => const TipResult(TipOutcome.unverified),
   113	        'busy' => const TipResult(TipOutcome.busy),
   114	        'unavailable' => const TipResult(TipOutcome.unavailable),
   115	        _ => TipResult(TipOutcome.failed, msg),
   116	      };
   117	    } catch (e) {
   118	      return TipResult(TipOutcome.failed, '$e');
   119	    } finally {
   120	      _buying = false;
   121	    }
   122	  }
   123	
   124	  @override
   125	  Future<PurchaseResult> buyPro() async {
   126	    if (!_started) await init();
   127	    if (_pro == null) return const PurchaseResult(PurchaseOutcome.unavailable);
   128	    if (_buying) return const PurchaseResult(PurchaseOutcome.busy);
   129	    _buying = true;
   130	    try {
   131	      final r = await _method.invokeMapMethod<String, Object?>('buyPro');
   132	      await _mirror;
   133	      return switch (r?['outcome']) {
   134	        'success' => const PurchaseResult(PurchaseOutcome.success),
   135	        'cancelled' => const PurchaseResult(PurchaseOutcome.cancelled),
   136	        'pending' => const PurchaseResult(PurchaseOutcome.pending),
   137	        'unverified' => const PurchaseResult(PurchaseOutcome.unverified),
   138	        'busy' => const PurchaseResult(PurchaseOutcome.busy),
   139	        'unavailable' => const PurchaseResult(PurchaseOutcome.unavailable),
   140	        _ => PurchaseResult(PurchaseOutcome.failed, r?['message'] as String?),
   141	      };
   142	    } catch (e) {
   143	      return PurchaseResult(PurchaseOutcome.failed, '$e');
   144	    } finally {
   145	      _buying = false;
   146	    }
   147	  }
   148	
   149	  /// Explicit restore: sync with the App Store, then Apple's entitlements decide.
   150	  /// Success with no entitlement turns the cache off; a failed sync leaves it alone.
   151	  @override
   152	  Future<PurchaseResult> restore() async {
   153	    if (!_started) await init();
   154	    if (!_started) return const PurchaseResult(PurchaseOutcome.unavailable);
   155	    try {
   156	      final r = await _method.invokeMapMethod<String, Object?>('restore');
   157	      if (r?['outcome'] == 'failed') return PurchaseResult(PurchaseOutcome.failed, r?['message'] as String?);
   158	      _applyPro({'pro': r?['pro'] == true});
   159	      await _mirror;
   160	      return r?['outcome'] == 'restored'
   161	          ? const PurchaseResult(PurchaseOutcome.restored)
   162	          : const PurchaseResult(PurchaseOutcome.nothingToRestore);
   163	    } catch (e) {
   164	      return PurchaseResult(PurchaseOutcome.failed, '$e');
   165	    }
   166	  }
   167	
   168	  void _onEvent(dynamic e) {
   169	    if (e is! Map) return;
   170	    if (e['type'] == 'pro') _applyPro(Map<String, Object?>.from(e));
   171	    if (e['type'] != 'tip') return;
   172	    if (e['status'] == 'thanks') _background.add(TipOutcome.thanks);
   173	    if (e['status'] == 'unverified') _background.add(TipOutcome.unverified);
   174	  }
   175	
   176	  /// Native answers are written in arrival order through one chain, so a stale
   177	  /// `true` can never land after a newer `false`.
   178	  void _applyPro(Map<String, Object?> snap) {
   179	    final pro = snap['pro'] == true;
   180	    _mirror = _mirror.then((_) async {
   181	      if (isPro != pro) await _prefs.setBool(_kPro, pro);
   182	      notifyListeners();
   183	    });
   184	  }
   185	
   186	  @override
   187	  void dispose() {
   188	    _sub?.cancel();
   189	    _background.close();
   190	    super.dispose();
   191	  }
   192	}
import Flutter
import Foundation

/// Bridges `StoreCoordinator` to Dart: method channel `stl2stp/store` and event
/// channel `stl2stp/store/events`. Installed independently of the background
/// and memory channels, and idempotent.
final class StoreChannelHost: NSObject, FlutterStreamHandler {
  private var events: FlutterEventSink?

  func install(messenger: FlutterBinaryMessenger) {
    let method = FlutterMethodChannel(name: "stl2stp/store", binaryMessenger: messenger)
    let stream = FlutterEventChannel(name: "stl2stp/store/events", binaryMessenger: messenger)
    stream.setStreamHandler(self)
    method.setMethodCallHandler { call, result in
      let args = call.arguments as? [String: Any]
      Task { @MainActor in
        let c = StoreCoordinator.shared
        switch call.method {
        case "start": result(await c.start())
        case "refresh": result(await c.refresh())
        case "buyPro": result(await c.buyPro())
        case "restore": result(await c.restore())
        case "loadProducts": result(await c.loadProducts())
        case "buyTip": result(await c.buyTip(productId: args?["productId"] as? String ?? ""))
        default: result(FlutterMethodNotImplemented)
        }
      }
    }
    Task {
      await StoreCoordinator.shared.setSink { [weak self] event in
        DispatchQueue.main.async { self?.events?(event) }
      }
    }
  }

  func onListen(withArguments arguments: Any?, eventSink events: @escaping FlutterEventSink) -> FlutterError? {
    self.events = events
    return nil
  }

  func onCancel(withArguments arguments: Any?) -> FlutterError? {
    events = nil
    return nil
  }
}
