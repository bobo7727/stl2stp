import Flutter
import UIKit
import os

@main
@objc class AppDelegate: FlutterAppDelegate {
  private var backgroundChannel: FlutterMethodChannel?
  private var memoryChannel: FlutterMethodChannel?
  private var storeHost: StoreChannelHost?
  private var backgroundTasks: [Int: UIBackgroundTaskIdentifier] = [:]
  private var nextTaskID = 1

  override func application(
    _ application: UIApplication,
    didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?
  ) -> Bool {
    GeneratedPluginRegistrant.register(with: self)
    // Start the one StoreKit 2 transaction listener as early as possible.
    Task { await StoreCoordinator.shared.begin() }
    let launched = super.application(application, didFinishLaunchingWithOptions: launchOptions)
    installNativeChannels()
    installStoreChannel()
    return launched
  }

  override func applicationDidBecomeActive(_ application: UIApplication) {
    super.applicationDidBecomeActive(application)
    // A host may attach its Flutter controller after didFinishLaunching.
    installNativeChannels()
    installStoreChannel()
  }

  override func applicationWillTerminate(_ application: UIApplication) {
    disposeNativeChannels()
    super.applicationWillTerminate(application)
  }

  /// Independent of the background/memory channels so an early return there
  /// can never skip it; idempotent.
  private func installStoreChannel() {
    guard storeHost == nil, let registrar = registrar(forPlugin: "Stl2StpStore") else { return }
    let host = StoreChannelHost()
    host.install(messenger: registrar.messenger())
    storeHost = host
  }

  private func installNativeChannels() {
    guard backgroundChannel == nil else { return }
    // The registry supplies the engine's messenger without assuming the root
    // controller is a FlutterViewController. Retry on activation if not ready.
    guard let registrar = registrar(forPlugin: "Stl2StpNativeRuntime") else { return }
    let messenger = registrar.messenger()
    let background = FlutterMethodChannel(name: "stl2stp/background", binaryMessenger: messenger)
    let memory = FlutterMethodChannel(name: "stl2stp/memory", binaryMessenger: messenger)
    backgroundChannel = background
    memoryChannel = memory

    background.setMethodCallHandler { [weak self] call, result in
      guard let self = self else {
        result(FlutterError(code: "unavailable", message: "Native runtime is unavailable", details: nil))
        return
      }
      switch call.method {
      case "begin":
        let arguments = call.arguments as? [String: Any]
        let name = arguments?["name"] as? String ?? "stl2stp-convert"
        result(self.beginBackgroundTask(name: name))
      case "end":
        guard let arguments = call.arguments as? [String: Any], let id = arguments["id"] as? Int else {
          result(FlutterError(code: "invalid_arguments", message: "end requires a task id", details: nil))
          return
        }
        self.endBackgroundTask(id: id)
        result(nil)
      default:
        result(FlutterMethodNotImplemented)
      }
    }

    memory.setMethodCallHandler { call, result in
import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

import '../core/estimate.dart';
import '../l10n/strings.dart';
import '../state/app_state.dart';
import '../theme/tokens.dart';
import '../widgets/common.dart';

enum ErrorKind { format, empty, tooBig, memory, cancelled, io, generic }

/// Error / cancelled screens (ui-spec §4.11).
class ErrorScreen extends StatelessWidget {
  const ErrorScreen(
      {super.key, required this.kind, this.code, this.details = '', this.faces, this.onPrimary, this.notice});
  final ErrorKind kind;
  final int? code;
  final String details;
  final int? faces;
  final void Function(BuildContext context)? onPrimary;

  /// Extra explanation shown under the body (e.g. why the app stopped the
  /// conversion itself: memory pressure, background time used up).
  final String? notice;

  @override
  Widget build(BuildContext context) {
    final s = S.of(context);
    final t = Tokens.of(context);
    final (icon, color, key) = switch (kind) {
      ErrorKind.format => (Icons.description_outlined, t.danger, 'format'),
      ErrorKind.empty => (Icons.view_in_ar_outlined, t.warning, 'empty'),
      ErrorKind.tooBig => (Icons.zoom_out_map, t.warning, 'too_big'),
      ErrorKind.memory => (Icons.memory, t.danger, 'memory'),
      ErrorKind.cancelled => (Icons.stop_circle_outlined, t.label2, 'cancelled'),
      ErrorKind.io => (Icons.folder_off_outlined, t.danger, 'io'),
      ErrorKind.generic => (Icons.warning_amber_rounded, t.danger, 'generic'),
    };
    final primary = switch (kind) {
      ErrorKind.format || ErrorKind.empty => s.t('error.choose_other'),
      ErrorKind.tooBig => s.t('error.too_big.action'),
      ErrorKind.memory => s.t('error.memory.action'),
      ErrorKind.cancelled => s.t('error.cancelled.action'),
      ErrorKind.io || ErrorKind.generic => s.t('common.retry'),
    };
    final copyDetails = kind == ErrorKind.memory || kind == ErrorKind.generic;
    final secondary = copyDetails
        ? s.t('error.copy_details')
        : kind == ErrorKind.cancelled
            ? s.t('error.choose_other')
            : s.t('common.back');
    final body = s.t('error.$key.body', {
      'code': code ?? '?',
      'faces': formatCount(faces ?? 0),
      'limit': formatCount(AppState.limitFaces),
    });
    return Scaffold(
      appBar: AppBar(),
      body: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(children: [
            const Spacer(),
            StatusIcon(icon: icon, color: color),
            const SizedBox(height: 20),
            Text(s.t('error.$key.title', {'code': code ?? '?'}),
                key: const Key('errorTitle'),
                textAlign: TextAlign.center,
                style: TextStyle(fontSize: 22, fontWeight: FontWeight.w700, color: t.label)),
            const SizedBox(height: 8),
            Text(body, textAlign: TextAlign.center, style: TextStyle(fontSize: 15, color: t.label2)),
            if (notice != null) ...[
              const SizedBox(height: 16),
              InfoBanner(key: const Key('errorNotice'), kind: BannerKind.warn, text: notice!),
            ],
            const Spacer(flex: 2),
            if (onPrimary != null)
              FilledButton(key: const Key('errorPrimary'), onPressed: () => onPrimary!(context), child: Text(primary)),
            TextButton(
              onPressed: () {
                if (copyDetails) {
                  Clipboard.setData(ClipboardData(
                      text: 'code=$code faces=$faces os=${Platform.operatingSystem} ${Platform.operatingSystemVersion}\n$details'));
                  ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(s.t('x.copied'))));
                } else if (kind == ErrorKind.cancelled) {
                  Navigator.of(context).popUntil((r) => r.isFirst);
                } else {
                  Navigator.of(context).maybePop();
                }
              },
              child: Text(secondary),
            ),
          ]),
        ),
      ),
    );
  }
}
import 'package:flutter/foundation.dart';

/// Product ids and other store configuration. Prices are never hard-coded:
/// the UI shows [ProductInfo.priceLabel] from the store, or a placeholder.
class PurchaseConfig {
  const PurchaseConfig({this.proProductId = 'com.stl2stp.app.pro'});

  /// One-time (non-consumable) "Pro" unlock. Must match App Store Connect.
  final String proProductId;
}

/// What the store reports about a product.
@immutable
class ProductInfo {
  const ProductInfo({required this.id, required this.title, required this.description, this.priceLabel});
  final String id;
  final String title;
  final String description;

  /// Localized price string from the store (e.g. StoreKit `displayPrice`);
  /// null when unknown, in which case the UI shows a placeholder.
  final String? priceLabel;
}

enum PurchaseOutcome { success, restored, nothingToRestore, cancelled, pending, failed, unavailable, unverified, busy }

@immutable
class PurchaseResult {
  const PurchaseResult(this.outcome, [this.message]);
  final PurchaseOutcome outcome;
  final String? message;
  bool get unlocked => outcome == PurchaseOutcome.success || outcome == PurchaseOutcome.restored;
}

/// Abstract purchase backend. One product: a one-time "Pro" unlock.
///
/// Implementations: [MockPurchaseService] (Linux / desktop / tests) and
/// `StorePurchaseService` (in_app_purchase → StoreKit on iOS).
abstract class PurchaseService extends ChangeNotifier {
  /// True once Pro is unlocked (cached locally so it works offline).
  bool get isPro;

  /// Whether the store can be reached right now.
  bool get available;

  /// The Pro product as reported by the store, once loaded.
  ProductInfo? get product;

  /// Whether Pro may be bought by users who do not own it. The iOS backend
  /// returns false: Pro is no longer sold there, only restored.
  bool get proForSale => true;

  /// True for the development mock (shows a "no charge" note).
  bool get isMock => false;

  /// Connects to the store and loads [product]. Safe to call more than once.
  Future<void> init();

  Future<PurchaseResult> buyPro();

  Future<PurchaseResult> restore();
}

