    84	  Future<MeshInfo> inspect(String path) async {
    85	    final lib = libraryPath;
    86	    final r = await Isolate.run(() => _inspectWorker(lib, path));
    87	    if (r['status'] as int < 0) throw LoadException(r['status'] as int, r['error'] as String);
    88	    final file = File(path);
    89	    final size = file.lengthSync();
    90	    final raf = file.openSync();
    91	    final head = raf.readSync(size < 84 ? size : 84);
    92	    raf.closeSync();
    93	    // Binary check needs the size: replicate looksAscii with a size-aware header.
    94	    final isAscii = _isAsciiHeader(head, size);
    95	    return MeshInfo(
    96	      path: path,
    97	      fileName: p.basename(path),
    98	      fileSize: size,
    99	      faces: r['faces'] as int,
   100	      vertices: r['vertices'] as int,
   101	      edges: r['edges'] as int,
   102	      min: (r['min'] as List).cast<double>(),
   103	      max: (r['max'] as List).cast<double>(),
   104	      isAscii: isAscii,
   105	    );
   106	  }
   107	
   108	  static bool _isAsciiHeader(List<int> head, int size) {
   109	    if (head.length >= 84) {
   110	      final n = head[80] | head[81] << 8 | head[82] << 16 | head[83] << 24;
   111	      if (84 + 50 * n == size) return false;
   112	    }
   113	    return looksAscii(Uint8List.fromList(head));
   114	  }
   115	
   116	  @override
   117	  Future<ConvertResult> convert(ConvertRequest request,
   118	      {required void Function(ConvertProgress) onProgress, required CancelToken cancel}) async {
   119	    final token = cancel as NativeCancelToken;
   120	    final port = ReceivePort();
   121	    final errPort = ReceivePort();
   122	    final exitPort = ReceivePort();
   123	    final stages = request.stages;
   124	    final sw = Stopwatch()..start();
   125	    final done = Completer<ConvertResult>();
   126	    final exited = Completer<void>();
   127	    final s = request.settings;
   128	    final iges = s.format == ExportFormat.iges;
   129	    String meta(String v) => iges ? stripNonAscii(v) : v.trim();
   130	    final args = <String, Object?>{
   131	      'port': port.sendPort,
   132	      'lib': libraryPath,
   133	      'cancel': token.address,
   134	      'in': request.inputPath,
   135	      'out': request.outputPath,
   136	      'format': s.format.name,
   137	      'simplify': s.simplify,
   138	      'target': s.targetFaces(request.faces),
   139	      'mode': s.mode.value,
   140	      'merge': s.mergeCoplanar,
   141	      'verify': s.verifyEffective,
   142	      'weld': s.weld,
   143	      'author': meta(s.author),
   144	      'org': meta(s.organization),
   145	      'product': meta(s.product),
   146	      'description': meta(s.description),
   147	    };
   148	    port.listen((msg) {
   149	      final m = msg as Map;
   150	      if (m['t'] == 'p') {
   151	        final st = Stage.values[m['s'] as int];
   152	        final f = (m['f'] as double).clamp(0.0, 1.0);
   153	        onProgress(ConvertProgress(st, f, overallProgress(stages, st, f)));
   154	      } else if (m['t'] == 'done' && !done.isCompleted) {
   155	        sw.stop();
   156	        final topo = m['topo'] as List;
   157	        done.complete(ConvertResult(
   158	          status: m['status'] as int,
   159	          outputPath: request.outputPath,
   160	          message: m['error'] as String,
   161	          topology: Topology(
   162	              solids: topo[0] as int, shells: topo[1] as int, faces: topo[2] as int, edges: topo[3] as int,
   163	              vertices: topo[4] as int),
   164	          verified: m['verified'] as bool?,
   165	          facesAfterSimplify: m['facesAfter'] as int?,
   166	          warnings: (m['warnings'] as List).cast<int>(),
   167	          elapsed: sw.elapsed,
   168	          failedStage: m['failed'] == null ? null : Stage.values[m['failed'] as int],
   169	        ));
   170	      }
   171	    });
   172	    errPort.listen((e) {
   173	      if (!done.isCompleted) {
   174	        done.complete(ConvertResult(
   175	            status: CoreStatus.errorInternal, outputPath: request.outputPath, message: 'worker error: $e'));
   176	      }
   177	    });
   178	    exitPort.listen((_) {
   179	      if (!exited.isCompleted) exited.complete();
   180	      if (!done.isCompleted) {
   181	        done.complete(ConvertResult(
   182	            status: CoreStatus.errorInternal, outputPath: request.outputPath, message: 'worker exited'));
   183	      }
   184	    });
   185	    await Isolate.spawn(_convertWorker, args, onError: errPort.sendPort, onExit: exitPort.sendPort);
   186	    try {
   187	      final r = await done.future;
   188	      // The worker sends 'done' before it destroys the native handle and frees
   189	      // its buffers. Wait for the isolate to exit so a conversion is only
   190	      // "finished" once its native resources are released (batch runs the next
   191	      // file straight after this one).
   192	      await exited.future.timeout(const Duration(seconds: 15), onTimeout: () {});
   193	      if (!r.ok) {
   194	        try {
   195	          final f = File(request.outputPath);
   196	          if (f.existsSync()) f.deleteSync();
   197	        } catch (_) {}
   198	      }
   199	      return r;
   200	    } finally {
   201	      port.close();
   202	      errPort.close();
   203	      exitPort.close();
   204	    }
   205	  }
   206	}
   207	
   208	DynamicLibrary _open(String? path) => path == null ? DynamicLibrary.process() : DynamicLibrary.open(path);
   209	
   210	Map<String, Object?> _inspectWorker(String? lib, String path) {
   211	  final b = Stl2StpBindings(_open(lib));
   212	  final h = b.create();
   213	  if (h == nullptr) return {'status': CoreStatus.errorMemory, 'error': 'create failed'};
   214	  final cPath = path.toNativeUtf8();
   215	  final stats = calloc<Stl2StpMeshStats>();
   216	  try {
   217	    var st = b.loadStl(h, cPath, nullptr);
   218	    if (st < 0) return {'status': st, 'error': b.errorOf(h)};
   219	    st = b.getMeshStats(h, stats);
   220	    if (st < 0) return {'status': st, 'error': b.errorOf(h)};
   221	    final s = stats.ref;
   222	    return {
   223	      'status': st,
   224	      'error': '',
   225	      'faces': s.faces,
   226	      'vertices': s.vertices,
   227	      'edges': s.edges,
   228	      'min': [s.minimum[0], s.minimum[1], s.minimum[2]],
   229	      'max': [s.maximum[0], s.maximum[1], s.maximum[2]],
   230	    };
   231	  } finally {
   232	    calloc.free(stats);
   233	    calloc.free(cPath);
   234	    b.destroy(h);
   235	  }
   236	}
   237	
   238	// ---- worker isolate state (isolate-local globals used by C callbacks) ----
   239	SendPort? _wPort;
   240	int _wStage = 0;
   241	double _wLast = -1;
   242	int _wLastMs = 0;
   243	final Stopwatch _wClock = Stopwatch();
   244	Pointer<Int32> _wCancel = nullptr;
   245	
   246	/// Export callback covers both "build faces" and "write file"; split at 70 %.
   247	bool _wExportSplit = false;
   248	
   249	void _post(int stage, double f, {bool force = false}) {
   250	  final now = _wClock.elapsedMilliseconds;
   251	  if (!force && stage == _wStage && (f - _wLast).abs() < 0.01 && now - _wLastMs < 50) return;
   252	  _wStage = stage;
   253	  _wLast = f;
   254	  _wLastMs = now;
   255	  _wPort?.send({'t': 'p', 's': stage, 'f': f});
   256	}
   257	
   258	void _onProgress(double fraction, Pointer<Void> _) {
   259	  if (_wExportSplit) {
   260	    if (fraction < 0.7) {
   261	      _post(Stage.build.index, fraction / 0.7);
   262	    } else {
   263	      _post(Stage.write.index, (fraction - 0.7) / 0.3);
   264	    }
   265	  } else {
   266	    _post(_wStage, fraction);
   267	  }
   268	}
   269	
   270	int _onCancel(Pointer<Void> _) => _wCancel == nullptr ? 0 : (_wCancel.value != 0 ? 1 : 0);
   271	
   272	void _convertWorker(Map<String, Object?> a) {
   273	  _wPort = a['port'] as SendPort;
   274	  _wCancel = Pointer<Int32>.fromAddress(a['cancel'] as int);
   275	  _wClock.start();
   276	  final b = Stl2StpBindings(_open(a['lib'] as String?));
   277	  final warnings = <int>[];
   278	  final topo = calloc<Stl2StpTopology>();
   279	  final topo2 = calloc<Stl2StpTopology>();
   280	  final stats = calloc<Stl2StpMeshStats>();
   281	  final cb = calloc<Stl2StpCallbacks>();
   282	  final opt = calloc<Stl2StpExportOptions>();
   283	  final strings = <Pointer<Utf8>>[];
   284	  Pointer<Utf8> str(String s) {
   285	    final ptr = s.toNativeUtf8();
   286	    strings.add(ptr);
   287	    return ptr;
   288	  }
   289	
   290	  cb.ref
   291	    ..progress = Pointer.fromFunction<ProgressNative>(_onProgress)
   292	    ..cancelled = Pointer.fromFunction<CancelNative>(_onCancel, 0)
   293	    ..userData = nullptr;
   294	  final h = b.create();
   295	  int? facesAfter;
   296	  bool? verified;
   297	  void finish(int status, {int? failed, String error = ''}) {
   298	    _wPort!.send({
   299	      't': 'done',
   300	      'status': status,
   301	      'error': error,
   302	      'failed': failed,
   303	      'warnings': warnings,
   304	      'facesAfter': facesAfter,
   305	      'verified': verified,
   306	      'topo': [topo.ref.solids, topo.ref.shells, topo.ref.faces, topo.ref.edges, topo.ref.vertices],
   307	    });
   308	  }
   309	
   310	  int note(int st) {
   311	    if (st > 0 && !warnings.contains(st)) warnings.add(st);
   312	    return st;
   313	  }
   314	
   315	  try {
   316	    if (h == nullptr) return finish(CoreStatus.errorMemory, failed: Stage.read.index, error: 'create failed');
   317	    // 1. read
   318	    _post(Stage.read.index, 0, force: true);
   319	    var st = note(b.loadStl(h, str(a['in'] as String), cb));
   320	    if (st < 0) return finish(st, failed: Stage.read.index, error: b.errorOf(h));
   321	    _post(Stage.read.index, 1, force: true);
   322	    // 2. simplify (weld first so QEM sees closed seams; core/weld)
   323	    if (a['simplify'] == true) {
   324	      _post(Stage.simplify.index, 0, force: true);
   325	      if (a['weld'] == true) {
   326	        final merged = calloc<Uint64>();
   327	        try {
   328	          st = b.weldVertices(h, 0, merged);
   329	          if (st < 0) return finish(st, failed: Stage.simplify.index, error: b.errorOf(h));
   330	          if (merged.value > 0) note(CoreStatus.warningRepaired);
   331	        } finally {
   332	          calloc.free(merged);
   333	        }
   334	      }
   335	      st = note(b.simplify(h, a['target'] as int, cb));
   336	      if (st < 0) return finish(st, failed: Stage.simplify.index, error: b.errorOf(h));
   337	      if (b.getMeshStats(h, stats) >= 0) facesAfter = stats.ref.faces;
   338	      _post(Stage.simplify.index, 1, force: true);
   339	    }
   340	    // 3+4. build + write
   341	    final d = b.defaultExportOptions();
   342	    opt.ref
   343	      ..sewingTolerance = d.sewingTolerance
   344	      ..mergeCoplanar = a['merge'] == true ? 1 : 0
   345	      ..mode = a['mode'] as int
   346	      ..author = str(a['author'] as String)
   347	      ..organization = str(a['org'] as String)
   348	      ..product = str(a['product'] as String)
   349	      ..description = str(a['description'] as String)
   350	      ..timestamp = nullptr
   351	      ..mergeAngularTolerance = d.mergeAngularTolerance
   352	      ..strictOriginal = d.strictOriginal
   353	      ..weldVertices = a['weld'] == true ? 1 : 0
   354	      ..weldTolerance = d.weldTolerance;
   355	    _post(Stage.build.index, 0, force: true);
   356	    _wExportSplit = true;
   357	    final out = str(a['out'] as String);
   358	    st = note(a['format'] == 'iges' ? b.exportIges(h, out, opt, cb, topo) : b.exportStep(h, out, opt, cb, topo));
   359	    _wExportSplit = false;
   360	    if (st < 0) {
   361	      final failed = _wStage == Stage.write.index ? Stage.write.index : Stage.build.index;
   362	      return finish(st, failed: failed, error: b.errorOf(h));
   363	    }
   364	    final exportMsg = st > 0 ? b.errorOf(h) : '';
   365	    _post(Stage.write.index, 1, force: true);
   366	    // 5. verify (STEP only)
   367	    if (a['verify'] == true) {
   368	      _post(Stage.verify.index, 0, force: true);
   369	      final v = b.readStep(h, out, cb, topo2);
   370	      if (v == CoreStatus.errorCancelled) return finish(v, failed: Stage.verify.index, error: b.errorOf(h));
   371	      final notSolid = warnings.contains(CoreStatus.warningNotSolid);
   372	      verified = v >= 0 && topo2.ref.faces > 0 && (topo2.ref.solids >= 1 || notSolid);
   373	      _post(Stage.verify.index, 1, force: true);
   374	    }
   375	    final finalStatus = warnings.isEmpty ? CoreStatus.ok : warnings.first;
   376	    finish(finalStatus, error: exportMsg);
   377	  } catch (e) {
   378	    finish(CoreStatus.errorInternal, error: '$e');
   379	  } finally {
   380	    if (h != nullptr) b.destroy(h);
   381	    for (final s in strings) {
   382	      calloc.free(s);
   383	    }
   384	    calloc.free(topo);
   385	    calloc.free(topo2);
   386	    calloc.free(stats);
   387	    calloc.free(cb);
   388	    calloc.free(opt);
   389	  }
   390	}
import 'package:flutter/material.dart';

import '../core/memory_guard.dart';
import '../core/models.dart';
import '../l10n/strings.dart';
import '../state/app_state.dart';
import '../theme/tokens.dart';
import '../core/estimate.dart' show formatBytes;

/// Memory pre-check before converting. Returns the settings to convert with
/// (possibly with simplification switched on), or null to stay on the preview.
Future<ConvertSettings?> ensureMemory(BuildContext context, int faces, ConvertSettings settings) async {
  final state = AppScope.read(context);
  final check = state.memoryGuard.check(faces, settings, state.memoryBudgetBytes);
  if (check.level == MemoryLevel.ok) return settings;
  final s = S.of(context);
  final t = Tokens.of(context);
  final refuse = check.level == MemoryLevel.refuse;
  final suggest = check.suggestPercent;
  final params = {
    'need': formatBytes(check.needBytes),
    'budget': formatBytes(check.budgetBytes),
    'percent': suggest ?? 5,
  };
  final choice = await showDialog<String>(
    context: context,
    builder: (ctx) => AlertDialog(
      key: const Key('memoryDialog'),
      icon: Icon(Icons.memory, color: refuse ? t.danger : t.warning),
      title: Text(s.t(refuse ? 'x.memory.refuse.title' : 'x.memory.warn.title')),
      content: Text(s.t(refuse ? 'x.memory.refuse.body' : 'x.memory.warn.body', params)),
      actions: [
        TextButton(onPressed: () => Navigator.pop(ctx, 'cancel'), child: Text(s.t('common.cancel'))),
        if (!refuse)
          TextButton(
              key: const Key('memoryContinue'),
              onPressed: () => Navigator.pop(ctx, 'continue'),
              child: Text(s.t('x.memory.continue'))),
        if (suggest != null)
          FilledButton(
              key: const Key('memorySimplify'),
              style: FilledButton.styleFrom(minimumSize: const Size(64, 40)),
              onPressed: () => Navigator.pop(ctx, 'simplify'),
              child: Text(s.t('x.memory.simplify', params))),
      ],
    ),
  );
  return switch (choice) {
    'continue' => settings,
    'simplify' => settings.copyWith(simplify: true, keepPercent: suggest),
    _ => null,
  };
}
