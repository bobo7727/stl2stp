   150	    super.dispose();
   151	  }
   152	
   153	  /// Ends the queue for [reason]. The first reason wins.
   154	  void stop(BatchStopReason reason) {
   155	    if (_finished) return;
   156	    _stopReason ??= reason;
   157	    _current?.cancel();
   158	  }
   159	
   160	  void _terminal(BatchItem it, BatchItemState s) {
   161	    if (it.isTerminal) return; // exactly one terminal state per file
   162	    it.state = s;
   163	    notifyListeners();
   164	  }
   165	
   166	  Future<void> run() async {
   167	    assert(!_started, 'BatchRunner.run() may be called once');
   168	    if (_started) return;
   169	    _started = true;
   170	    for (var i = 0; i < items.length; i++) {
   171	      final it = items[i];
   172	      _index = i;
   173	      if (_stopReason == null && isAllowed != null && !isAllowed!()) _stopReason = BatchStopReason.entitlement;
   174	      if (_stopReason != null) {
   175	        it.stopReason = _stopReason;
   176	        _terminal(it, BatchItemState.notRun);
   177	        continue;
   178	      }
   179	      final faces = it.input.faces;
   180	      if (faces == null) {
   181	        it.status = CoreStatus.errorFormat;
   182	        it.message = 'unreadable';
   183	        _terminal(it, BatchItemState.failed);
   184	        continue;
   185	      }
   186	      if (faces > limitFaces) {
   187	        it.reasonKey = 'batch.skip.faces';
   188	        _terminal(it, BatchItemState.skipped);
   189	        continue;
   190	      }
   191	      if (memoryGuard.check(faces, settings, budgetBytes).level == MemoryLevel.refuse) {
   192	        it.reasonKey = 'batch.skip.memory';
   193	        _terminal(it, BatchItemState.skipped);
   194	        continue;
   195	      }
   196	      await _runOne(it, faces);
   197	    }
   198	    _index = -1;
   199	    _finished = true;
   200	    notifyListeners();
   201	  }
   202	
   203	  Future<void> _runOne(BatchItem it, int faces) async {
   204	    final token = _current = engine.newCancelToken();
   205	    it.state = BatchItemState.running;
   206	    notifyListeners();
   207	    final request = ConvertRequest(
   208	      inputPath: it.input.path,
   209	      outputPath: outputPathFor(it.input.path, settings.format),
   210	      settings: settings,
   211	      faces: faces,
   212	    );
   213	    ConvertResult r;
   214	    try {
   215	      r = await engine.convert(request, cancel: token, onProgress: (p) {
   216	        it.stage = p.stage;
   217	        it.progress = p.overall;
   218	        notifyListeners();
   219	      });
   220	    } catch (e) {
   221	      r = ConvertResult(status: CoreStatus.errorInternal, outputPath: request.outputPath, message: '$e');
   222	    } finally {
   223	      token.dispose();
   224	      _current = null;
   225	    }
   226	    it.result = r;
   227	    if (r.ok) {
   228	      // A finished conversion stays done even if a stop arrived at the boundary.
   229	      try {
   230	        onFileDone(it, r);
   231	      } catch (e) {
   232	        debugPrint('batch onFileDone failed: $e');
   233	      }
   234	      _terminal(it, BatchItemState.done);
   235	    } else if (r.status == CoreStatus.errorCancelled) {
   236	      // A cancelled file always ends the queue, even if the engine reported it unprompted.
   237	      it.stopReason = _stopReason ??= BatchStopReason.cancelled;
   238	      _terminal(it, BatchItemState.notRun);
   239	    } else {
   240	      it.status = r.status;
   241	      it.message = r.message;
   242	      _terminal(it, BatchItemState.failed);
   243	    }
   244	  }
   245	}

