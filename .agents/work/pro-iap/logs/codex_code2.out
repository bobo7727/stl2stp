   224	  @override
   225	  void initState() {
   226	    super.initState();
   227	    final state = _state = AppScope.read(context);
   228	    _runner = BatchRunner(
   229	      engine: state.engine,
   230	      inputs: widget.inputs, // unreadable files end as failed, so totals match the selection
   231	      settings: widget.settings,
   232	      memoryGuard: state.memoryGuard,
   233	      budgetBytes: state.memoryBudgetBytes,
   234	      outputPathFor: state.outputPathFor,
   235	      isAllowed: () => state.batchLimit() == null,
   236	      onFileDone: (item, r) {
   237	        final bytes = File(r.outputPath).existsSync() ? File(r.outputPath).lengthSync() : 0;
   238	        state.recordConversion();
   239	        state.addHistory(HistoryEntry(
   240	          outputPath: r.outputPath,
   241	          format: widget.settings.format,
   242	          bytes: bytes,
   243	          time: DateTime.now(),
   244	          sourceName: item.input.name,
   245	          settings: widget.settings,
   246	        ));
   247	      },
   248	    )..addListener(_changed);
   249	    WidgetsBinding.instance.addObserver(this);
   250	    state.haptics.start();
   251	    // One background task for the whole batch.
   252	    state.background
   253	        .begin('stl2stp-convert', onExpire: () => _runner.stop(BatchStopReason.background))
   254	        .then((id) => _ended ? state.background.end(id) : _backgroundTask = id);
   255	    WidgetsBinding.instance.addPostFrameCallback((_) => _go());
   256	  }
