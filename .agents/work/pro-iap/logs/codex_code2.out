import 'dart:io';

import 'package:flutter/foundation.dart';
import 'package:flutter/services.dart';

/// Lets a running conversion continue for a while after the app goes to the
/// background.
///
/// Flutter keeps the Dart isolates alive only as long as the OS keeps the
/// process running. On iOS the process is suspended a few seconds after
/// leaving the foreground unless the app holds a background task
/// (`UIApplication.beginBackgroundTask`, typically ~30 s, sometimes more).
/// The native side lives in the iOS runner (docs/mac-setup-guide.md §后台转换):
/// channel `stl2stp/background`, methods `begin` → task id, `end(id)`, and a
/// call back to Dart `expired(id)` from the expiration handler.
///
/// On every other platform this is a no-op: desktop apps keep running in the
/// background, and Android is not targeted yet.
class BackgroundTasks {
  BackgroundTasks({MethodChannel? channel, bool? enabled})
      : _channel = channel ?? const MethodChannel('stl2stp/background'),
        enabled = enabled ?? (!kIsWeb && Platform.isIOS) {
    if (this.enabled) _channel.setMethodCallHandler(_onCall);
  }

  final MethodChannel _channel;

  /// False → [begin]/[end] do nothing (Linux, desktop, widget tests).
  final bool enabled;
  final _onExpire = <int, VoidCallback>{};

  /// Starts a background task; returns its id, or null when unsupported or the
  /// native side is missing. [onExpire] runs if the OS is about to suspend the
  /// app before [end] is called (the conversion should be cancelled then).
  Future<int?> begin(String name, {VoidCallback? onExpire}) async {
    if (!enabled) return null;
    try {
      final id = await _channel.invokeMethod<int>('begin', {'name': name});
      if (id != null && onExpire != null) _onExpire[id] = onExpire;
      return id;
    } on MissingPluginException {
      return null;
    } on PlatformException {
      return null;
    }
  }

  /// Ends a task started with [begin] (null is ignored).
  Future<void> end(int? id) async {
    if (!enabled || id == null) return;
    _onExpire.remove(id);
    try {
      await _channel.invokeMethod<void>('end', {'id': id});
    } on MissingPluginException {
      // native side not installed: nothing to end
    } on PlatformException {
      // already ended by the OS
    }
  }

  Future<Object?> _onCall(MethodCall call) async {
    if (call.method == 'expired') handleExpired(call.arguments as int);
    return null;
  }

  /// The OS is about to end background task [id] (also used by tests).
  @visibleForTesting
  void handleExpired(int id) => _onExpire.remove(id)?.call();
}
import 'dart:async';
import 'dart:io';

import 'package:flutter/material.dart';
import 'package:path/path.dart' as p;

import '../core/engine.dart';
import '../core/models.dart';
import '../l10n/strings.dart';
import '../state/app_state.dart';
import '../state/history.dart';
import '../theme/tokens.dart';
import '../widgets/common.dart';
import 'done_screen.dart';
import 'error_screen.dart';
import 'flow.dart';
import 'preview_screen.dart';

/// Full-screen progress (ui-spec §4.7), not dismissible; cancel asks first (§4.8).
class ConvertingScreen extends StatefulWidget {
  const ConvertingScreen({super.key, required this.request, required this.model});
  final ConvertRequest request;
  final LoadedModel model;
  @override
  State<ConvertingScreen> createState() => _ConvertingScreenState();
}

class _ConvertingScreenState extends State<ConvertingScreen> with WidgetsBindingObserver {
  late final CancelToken _cancel;
  late final AppState _state;

  /// Why the conversion was cancelled by the app itself (not the user).
  String? _autoCancelKey;
  bool _running = true;
  int? _backgroundTask;

  /// Time spent with the app in the background during this conversion.
  final _backgroundClock = Stopwatch();
  late final List<Stage> _stages = widget.request.stages;
  ConvertProgress? _progress;
  final _sw = Stopwatch();
  Timer? _tick;
  DateTime _lastUi = DateTime.fromMillisecondsSinceEpoch(0);

  @override
  void initState() {
    super.initState();
    final state = _state = AppScope.read(context);
    _cancel = state.engine.newCancelToken();
    WidgetsBinding.instance.addObserver(this);
    state.haptics.start();
    // iOS: keep running for a while if the user leaves the app (no-op elsewhere).
    state.background
        .begin('stl2stp-convert', onExpire: () => _autoCancel('x.background.expired'))
        .then((id) => _running ? _backgroundTask = id : state.background.end(id));
    _sw.start();
    _tick = Timer.periodic(const Duration(milliseconds: 500), (_) => setState(() {}));
    WidgetsBinding.instance.addPostFrameCallback((_) => _run(state));
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _tick?.cancel();
    _endBackgroundTask();
    super.dispose();
  }

  void _endBackgroundTask() {
    final id = _backgroundTask;
    _backgroundTask = null;
    if (id != null) _state.background.end(id);
  }

  /// Cancels the running conversion for an app-side reason ([reasonKey] is the
  /// message shown on the error screen).
  void _autoCancel(String reasonKey) {
    if (!_running || _cancel.isCancelled) return;
    _autoCancelKey = reasonKey;
    _cancel.cancel();
  }

  @override
  void didHaveMemoryPressure() {
    // iOS memory warning / Android onTrimMemory: stop cleanly before the OS kills the app.
    _autoCancel('x.memory.pressure');
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.paused || state == AppLifecycleState.hidden) {
      if (!_backgroundClock.isRunning) _backgroundClock.start();
    } else if (state == AppLifecycleState.resumed) {
      _backgroundClock.stop();
    }
  }

  Future<void> _run(AppState state) async {
    final r = await state.engine.convert(widget.request, cancel: _cancel, onProgress: (pr) {
      // Throttle UI updates to ≤ 20 per second.
      final now = DateTime.now();
      if (now.difference(_lastUi).inMilliseconds >= 50 || pr.stage != _progress?.stage) {
        _lastUi = now;
        if (mounted) setState(() => _progress = pr);
      }
    });
    _running = false;
    _cancel.dispose();
    _sw.stop();
    _endBackgroundTask();
    if (r.ok) {
      state.haptics.success();
    } else if (r.status != CoreStatus.errorCancelled || _autoCancelKey != null) {
      state.haptics.failure();
    }
    if (!mounted) return;
    final nav = Navigator.of(context);
    if (r.ok) {
      final bytes = File(r.outputPath).existsSync() ? File(r.outputPath).lengthSync() : 0;
      state.recordConversion();
      state.addHistory(HistoryEntry(
        outputPath: r.outputPath,
        format: widget.request.settings.format,
        bytes: bytes,
        time: DateTime.now(),
        sourceName: p.basename(widget.request.inputPath),
        settings: widget.request.settings,
      ));
      nav.pushReplacement(MaterialPageRoute(builder: (_) => DoneScreen(request: widget.request, result: r, bytes: bytes)));
      return;
    }
    final auto = _autoCancelKey;
    final kind = switch (r.status) {
      CoreStatus.errorCancelled when auto == 'x.memory.pressure' => ErrorKind.memory,
      CoreStatus.errorCancelled when auto != null => ErrorKind.generic,
      CoreStatus.errorCancelled => ErrorKind.cancelled,
      CoreStatus.errorMemory => ErrorKind.memory,
      CoreStatus.errorEmpty => ErrorKind.empty,
      CoreStatus.errorFormat => ErrorKind.format,
      CoreStatus.errorIo => r.failedStage == Stage.read ? ErrorKind.format : ErrorKind.io,
      _ => ErrorKind.generic,
    };
    final model = widget.model;
    final settings = widget.request.settings;
    nav.pushReplacement(MaterialPageRoute(
      builder: (_) => ErrorScreen(
        kind: kind,
        code: r.status,
        details: auto != null ? S.of(context).t(auto) : r.message,
        notice: auto != null ? S.of(context).t(auto) : null,
        faces: model.info.faces,
        onPrimary: (ctx) {
          switch (kind) {
            case ErrorKind.cancelled:
              Navigator.of(ctx).pop();
            case ErrorKind.memory:
              Navigator.of(ctx).pushReplacement(MaterialPageRoute(
                  builder: (_) => PreviewScreen(model: model, initialSettings: settings, forceSimplifyPercent: 50)));
            case ErrorKind.io:
            case ErrorKind.generic:
              Navigator.of(ctx).pushReplacement(
                  MaterialPageRoute(builder: (_) => ConvertingScreen(request: widget.request, model: model)));
            default:
              pickStl(ctx).then((path) {
                if (path != null && ctx.mounted) openModel(ctx, path, replace: true);
              });
          }
        },
      ),
    ));
  }

  Future<void> _askCancel() async {
    final s = S.of(context);
    final t = Tokens.of(context);
    final yes = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text(s.t('cancel.confirm.title')),
        content: Text(s.t('cancel.confirm.body')),
        actions: [
          TextButton(
              key: const Key('cancelYes'),
              onPressed: () => Navigator.pop(ctx, true),
              child: Text(s.t('cancel.confirm.yes'), style: TextStyle(color: t.danger))),
          FilledButton(
              style: FilledButton.styleFrom(minimumSize: const Size(64, 40)),
              onPressed: () => Navigator.pop(ctx, false),
              child: Text(s.t('cancel.confirm.no'))),
        ],
      ),
    );
    if (yes == true) _cancel.cancel();
  }

  @override
  Widget build(BuildContext context) {
    final s = S.of(context);
    final t = Tokens.of(context);
    final pr = _progress;
    final secs = _sw.elapsed.inSeconds;
    final elapsed = secs < 60
        ? (s.isZh ? '$secs 秒' : '$secs s')
        : '${secs ~/ 60}:${(secs % 60).toString().padLeft(2, '0')}';
    final currentIdx = pr == null ? 0 : _stages.indexOf(pr.stage);
    return PopScope(
      canPop: false,
      child: Scaffold(
        appBar: AppBar(title: Text(s.t('converting.title')), automaticallyImplyLeading: false),
        body: SafeArea(
          child: Column(children: [
            const SizedBox(height: 24),
            ProgressRing(value: pr?.overall ?? 0),
            const SizedBox(height: 16),
            Text(p.basename(widget.request.outputPath),
                style: TextStyle(fontSize: 17, fontWeight: FontWeight.w600, color: t.label)),
            Text(s.t('converting.elapsed', {'t': elapsed}),
                style: TextStyle(fontSize: 13, color: t.label2, fontFeatures: tabular)),
            const SizedBox(height: 24),
            Expanded(
              child: Align(
                alignment: Alignment.topCenter,
                child: ConstrainedBox(
                  constraints: const BoxConstraints(maxWidth: 320),
                  child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                    for (final (i, st) in _stages.indexed)
                      Padding(
                        padding: const EdgeInsets.symmetric(vertical: 6),
                        child: Row(children: [
                          if (i < currentIdx)
                            Icon(Icons.check_circle, color: t.success, size: 22)
                          else if (i == currentIdx)
                            Icon(Icons.radio_button_checked, color: t.accent, size: 22)
                          else
                            Icon(Icons.radio_button_unchecked, color: t.label3, size: 22),

