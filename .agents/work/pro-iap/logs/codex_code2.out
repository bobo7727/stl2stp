   321	          CoreStatus.errorMemory => 'error.memory.title',
   322	          CoreStatus.errorEmpty => 'error.empty.title',
   323	          CoreStatus.errorFormat || CoreStatus.errorIo => 'error.format.title',
   324	          _ => 'error.generic.title',
   325	        };
   326	        return s.t(key);
   327	      default:
