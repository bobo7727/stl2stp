+      await tester.tap(find.byKey(const Key('batchStart')));
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 400));
+      for (var i = 0; i < 50 && find.byKey(const Key('batchFinish')).evaluate().isEmpty; i++) {
