   313	  String _reason(S s, BatchItem it) {
   314	    switch (it.state) {
   315	      case BatchItemState.skipped:
   316	        return s.t(it.reasonKey ?? 'batch.state.skipped');
   317	      case BatchItemState.notRun:
   318	        return s.t('batch.stop.${(it.stopReason ?? BatchStopReason.cancelled).name}');
   319	      case BatchItemState.failed:
