+import 'package:flutter/foundation.dart';
+
+import '../core/engine.dart';
+import '../core/memory_guard.dart';
+import '../core/models.dart';
+
+/// One file picked for a batch.
+class BatchInput {
+  const BatchInput({required this.path, required this.name, required this.size, this.faces});
+  final String path;
+  final String name;
+  final int size;
+
+  /// Face count from `inspect`; null = could not be read (not part of the run).
+  final int? faces;
+
+  BatchInput withFaces(int? f) => BatchInput(path: path, name: name, size: size, faces: f);
+}
+
+enum BatchItemState { waiting, running, done, failed, skipped, notRun }
+
+/// Why the queue stopped before every file was handled.
+enum BatchStopReason { cancelled, memory, background, entitlement }
+
+/// Mutable per-file status. Every item ends in exactly one terminal state
+/// (done / failed / skipped / notRun); see [BatchRunner].
+class BatchItem {
+  BatchItem(this.input);
+  final BatchInput input;
+  BatchItemState state = BatchItemState.waiting;
+
+  /// i18n key for the skip reason (skipped only).
+  String? reasonKey;
+
+  /// Why the queue stopped (notRun only).
+  BatchStopReason? stopReason;
+
+  /// Engine status and message (failed only).
+  int? status;
+  String message = '';
+  ConvertResult? result;
+  double progress = 0;
+  Stage? stage;
+
+  bool get isTerminal =>
+      state == BatchItemState.done ||
+      state == BatchItemState.failed ||
+      state == BatchItemState.skipped ||
+      state == BatchItemState.notRun;
+}
+
+class BatchSummary {
+  const BatchSummary(this.done, this.failed, this.skipped, this.notRun);
+  final int done, failed, skipped, notRun;
+  int get total => done + failed + skipped + notRun;
+}
+
+/// Sequential batch queue (PLAN §8.3, §14c P10/P14). Pure Dart, no UI.
+///
+/// - Files run one at a time (no stacked memory peaks).
+/// - A failing file is recorded and the queue continues.
+/// - [stop] ends the queue: the running file is cancelled and recorded as
+///   `notRun` with the reason, remaining files become `notRun`. If the engine
+///   already finished the running file successfully, it stays `done`.
+/// - Entitlement is re-checked between files ([isAllowed]); a revoked
+///   entitlement lets the current file finish and stops the queue.
+/// - Every item gets exactly one terminal state, so the summary total always
+///   equals the number of selected files.
+class BatchRunner extends ChangeNotifier {
+  BatchRunner({
+    required this.engine,
+    required List<BatchInput> inputs,
+    required this.settings,
+    required this.memoryGuard,
+    required this.budgetBytes,
+    required this.outputPathFor,
+    required this.onFileDone,
+    this.isAllowed,
+    this.limitFaces = 2000000,
+  }) : items = [for (final i in inputs) BatchItem(i)];
+
+  final ConversionEngine engine;
+  final List<BatchItem> items;
+  final ConvertSettings settings;
+  final MemoryGuard memoryGuard;
+  final int budgetBytes;
+
+  /// Output path for a source file (must not collide with earlier outputs).
+  final String Function(String sourcePath, ExportFormat f) outputPathFor;
+
+  /// Called once for each successfully converted file (history, counters).
+  final void Function(BatchItem item, ConvertResult result) onFileDone;
+
+  /// False when Pro is no longer active. Null = always allowed.
+  final bool Function()? isAllowed;
+  final int limitFaces;
+
+  BatchStopReason? _stopReason;
+  CancelToken? _current;
+  int _index = -1;
+  bool _started = false;
+  bool _finished = false;
+
+  /// 0-based index of the file being processed, or -1.
+  int get currentIndex => _index;
+  bool get finished => _finished;
+  BatchStopReason? get stopReason => _stopReason;
+
+  BatchSummary get summary {
+    var d = 0, f = 0, s = 0, n = 0;
+    for (final i in items) {
+      switch (i.state) {
+        case BatchItemState.done:
+          d++;
+        case BatchItemState.failed:
+          f++;
+        case BatchItemState.skipped:
+          s++;
+        case BatchItemState.notRun:
+          n++;
+        case BatchItemState.waiting:
+        case BatchItemState.running:
+          break;
+      }
+    }
+    return BatchSummary(d, f, s, n);
+  }
+
+  /// Fraction of files that reached a terminal state, plus the running one's progress.
+  double get overall {
+    if (items.isEmpty) return 1;
+    var sum = 0.0;
+    for (final i in items) {
+      sum += i.isTerminal ? 1 : (i.state == BatchItemState.running ? i.progress : 0);
+    }
+    return sum / items.length;
+  }
+
+  bool _disposed = false;
+
+  @override
+  void notifyListeners() {
+    if (!_disposed) super.notifyListeners();
+  }
+
+  /// Safe while the queue is still running: later updates are dropped.
+  @override
+  void dispose() {
+    _disposed = true;
+    super.dispose();
+  }
+
+  /// Ends the queue for [reason]. The first reason wins.
+  void stop(BatchStopReason reason) {
+    if (_finished) return;
+    _stopReason ??= reason;
+    _current?.cancel();
+  }
+
+  void _terminal(BatchItem it, BatchItemState s) {
+    if (it.isTerminal) return; // exactly one terminal state per file
+    it.state = s;
+    notifyListeners();
+  }
+
+  Future<void> run() async {
+    assert(!_started, 'BatchRunner.run() may be called once');
+    if (_started) return;
+    _started = true;
+    for (var i = 0; i < items.length; i++) {
+      final it = items[i];
+      _index = i;
+      if (_stopReason == null && isAllowed != null && !isAllowed!()) _stopReason = BatchStopReason.entitlement;
+      if (_stopReason != null) {
+        it.stopReason = _stopReason;
+        _terminal(it, BatchItemState.notRun);
+        continue;
+      }
+      final faces = it.input.faces;
+      if (faces == null) {
+        it.status = CoreStatus.errorFormat;
+        it.message = 'unreadable';
+        _terminal(it, BatchItemState.failed);
+        continue;
+      }
+      if (faces > limitFaces) {
+        it.reasonKey = 'batch.skip.faces';
+        _terminal(it, BatchItemState.skipped);
+        continue;
+      }
+      if (memoryGuard.check(faces, settings, budgetBytes).level == MemoryLevel.refuse) {
+        it.reasonKey = 'batch.skip.memory';
+        _terminal(it, BatchItemState.skipped);
+        continue;
+      }
+      await _runOne(it, faces);
+    }
+    _index = -1;
+    _finished = true;
+    notifyListeners();
+  }
+
+  Future<void> _runOne(BatchItem it, int faces) async {
+    final token = _current = engine.newCancelToken();
+    it.state = BatchItemState.running;
+    notifyListeners();
+    final request = ConvertRequest(
+      inputPath: it.input.path,
+      outputPath: outputPathFor(it.input.path, settings.format),
+      settings: settings,
+      faces: faces,
+    );
+    ConvertResult r;
+    try {
+      r = await engine.convert(request, cancel: token, onProgress: (p) {
+        it.stage = p.stage;
+        it.progress = p.overall;
+        notifyListeners();
+      });
+    } catch (e) {
+      r = ConvertResult(status: CoreStatus.errorInternal, outputPath: request.outputPath, message: '$e');
+    } finally {
+      token.dispose();
+      _current = null;
+    }
+    it.result = r;
+    if (r.ok) {
+      // A finished conversion stays done even if a stop arrived at the boundary.
+      try {
+        onFileDone(it, r);
+      } catch (e) {
+        debugPrint('batch onFileDone failed: $e');
+      }
+      _terminal(it, BatchItemState.done);
+    } else if (r.status == CoreStatus.errorCancelled) {
+      // A cancelled file always ends the queue, even if the engine reported it unprompted.
+      it.stopReason = _stopReason ??= BatchStopReason.cancelled;
+      _terminal(it, BatchItemState.notRun);
+    } else {
+      it.status = r.status;
+      it.message = r.message;
+      _terminal(it, BatchItemState.failed);
+    }
+  }
+}
diff --git a/mobile/app/lib/screens/batch_screen.dart b/mobile/app/lib/screens/batch_screen.dart
new file mode 100644
index 0000000..516709b
--- /dev/null
+++ b/mobile/app/lib/screens/batch_screen.dart
@@ -0,0 +1,434 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:path/path.dart' as p;
+import 'package:share_plus/share_plus.dart';
+
+import '../batch/batch_runner.dart';
+import '../core/estimate.dart' show formatBytes, formatCount;
+import '../core/models.dart';
+import '../l10n/strings.dart';
+import '../state/app_state.dart';
+import '../state/history.dart';
+import '../theme/tokens.dart';
+import '../widgets/common.dart';
+import 'flow.dart';
+import 'paywall_screen.dart';
+
+/// Home entry for batch conversion: checks the entitlement, then picks files
+/// and opens [BatchScreen] (PLAN §8.1).
+Future<void> startBatchFlow(BuildContext context) async {
+  if (!await ensureBatchAllowed(context) || !context.mounted) return;
+  final paths = await pickStls(context);
+  if (paths.isEmpty || !context.mounted) return;
+  await Navigator.of(context).push(MaterialPageRoute(builder: (_) => BatchScreen(paths: paths)));
+}
+
+/// Shows the paywall until batch is allowed. A purchase is followed by a fresh
+/// check (§14c P10). Returns false when the user stays out.
+Future<bool> ensureBatchAllowed(BuildContext context) async {
+  for (var i = 0; i < 3; i++) {
+    final hit = AppScope.read(context).batchLimit();
+    if (hit == null) return true;
+    final r = await Navigator.push<PaywallResult>(context, MaterialPageRoute(builder: (_) => PaywallScreen(reason: hit)));
+    if (!context.mounted) return false;
+    if (r is! PaywallPurchased) return false;
+  }
+  return false;
+}
+
+/// Setup page: file list, shared settings, start (PLAN §8.2).
+class BatchScreen extends StatefulWidget {
+  const BatchScreen({super.key, required this.paths});
+  final List<String> paths;
+  @override
+  State<BatchScreen> createState() => _BatchScreenState();
+}
+
+class _BatchScreenState extends State<BatchScreen> {
+  late List<BatchInput> _inputs;
+  bool _reading = true;
+  bool _disposed = false;
+  bool _truncated = false;
+  late ConvertSettings _settings;
+  final _meta = List.generate(4, (_) => TextEditingController());
+
+  @override
+  void initState() {
+    super.initState();
+    final state = AppScope.read(context);
+    final unique = <String>[];
+    for (final path in widget.paths) {
+      if (!unique.contains(path)) unique.add(path);
+    }
+    _truncated = unique.length > maxBatchFiles;
+    final paths = unique.take(maxBatchFiles);
+    _inputs = [
+      for (final path in paths)
+        BatchInput(
+            path: path,
+            name: p.basename(path),
+            size: File(path).existsSync() ? File(path).lengthSync() : 0)
+    ];
+    final base = state.initialSettings();
+    _settings = ConvertSettings.forPreset(Preset.recommended, format: base.format).copyWith(
+        author: base.author, organization: base.organization, product: base.product, description: base.description);
+    _meta[0].text = base.author;
+    _meta[1].text = base.organization;
+    _meta[2].text = base.product;
+    _meta[3].text = base.description;
+    WidgetsBinding.instance.addPostFrameCallback((_) => _inspectAll(state));
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    for (final c in _meta) {
+      c.dispose();
+    }
+    super.dispose();
+  }
+
+  /// One at a time; stops as soon as the page is left (§14c P12).
+  Future<void> _inspectAll(AppState state) async {
+    for (var i = 0; i < _inputs.length; i++) {
+      if (_disposed) return;
+      int? faces;
+      try {
+        faces = (await state.engine.inspect(_inputs[i].path)).faces;
+      } catch (_) {
+        faces = null;
+      }
+      if (_disposed) return;
+      setState(() => _inputs[i] = _inputs[i].withFaces(faces));
+    }
+    if (!_disposed) setState(() => _reading = false);
+  }
+
+  ConvertSettings get _final => _settings.copyWith(
+      author: _meta[0].text, organization: _meta[1].text, product: _meta[2].text, description: _meta[3].text);
+
+  Future<void> _start() async {
+    // Entitlement is checked again at the moment of starting (§14c P10).
+    if (!await ensureBatchAllowed(context) || !mounted) return;
+    final state = AppScope.read(context);
+    final settings = _final;
+    state.rememberSettings(settings);
+    await Navigator.of(context).pushReplacement(MaterialPageRoute(
+        builder: (_) => BatchRunningScreen(inputs: _inputs, settings: settings)));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final s = S.of(context);
+    final t = Tokens.of(context);
+    final ready = _inputs.where((i) => i.faces != null).length;
+    return Scaffold(
+      appBar: AppBar(title: Text(s.t('batch.title'))),
+      body: ListView(padding: const EdgeInsets.all(16), children: [
+        Text(s.t('batch.count', {'n': _inputs.length}),
+            style: TextStyle(fontSize: 15, color: t.label2)),
+        if (_truncated) ...[
+          const SizedBox(height: 8),
+          InfoBanner(kind: BannerKind.warn, text: s.t('batch.too_many', {'max': maxBatchFiles})),
+        ],
+        if (_reading) ...[
+          const SizedBox(height: 8),
+          Row(children: [
+            const SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2)),
+            const SizedBox(width: 8),
+            Text(s.t('batch.reading'), style: TextStyle(color: t.label2)),
+          ]),
+        ],
+        const SizedBox(height: 8),
+        Surface(
+          padding: EdgeInsets.zero,
+          child: Column(children: [
+            for (final i in _inputs)
+              ListTile(
+                dense: true,
+                title: Text(i.name, maxLines: 1, overflow: TextOverflow.ellipsis),
+                subtitle: Text(formatBytes(i.size), style: TextStyle(color: t.label2)),
+                trailing: Text(
+                    i.faces != null
+                        ? s.t('batch.faces', {'faces': formatCount(i.faces!)})
+                        : (_reading ? '…' : s.t('batch.unreadable')),
+                    style: TextStyle(color: i.faces == null && !_reading ? t.danger : t.label2)),
+              ),
+          ]),
+        ),
+        SectionHeader(s.t('batch.settings')),
+        Text(s.t('batch.format'), style: TextStyle(color: t.label2)),
+        const SizedBox(height: 4),
+        SegmentedButton<ExportFormat>(
+          key: const Key('batchFormat'),
+          segments: [for (final f in ExportFormat.values) ButtonSegment(value: f, label: Text(f.label))],
+          selected: {_settings.format},
+          onSelectionChanged: (v) => setState(() => _settings = _settings.copyWith(format: v.first)),
+        ),
+        const SizedBox(height: 12),
+        Text(s.t('batch.preset'), style: TextStyle(color: t.label2)),
+        const SizedBox(height: 4),
+        SegmentedButton<Preset>(
+          key: const Key('batchPreset'),
+          segments: [for (final pr in Preset.values) ButtonSegment(value: pr, label: Text(s.t('preset.${pr.name}')))],
+          selected: {_settings.preset ?? Preset.recommended},
+          onSelectionChanged: (v) => setState(() => _settings = _settings.withPreset(v.first)),
+        ),
+        const SizedBox(height: 8),
+        ExpansionTile(
+          title: Text(s.t('batch.meta')),
+          tilePadding: EdgeInsets.zero,
+          children: [
+            for (final (n, k) in ['author', 'org', 'product', 'description'].indexed)
+              Padding(
+                padding: const EdgeInsets.only(bottom: 8),
+                child: TextField(
+                    controller: _meta[n],
+                    decoration: InputDecoration(labelText: s.t('advanced.meta.$k'), hintText: s.t('advanced.meta.placeholder'))),
+              ),
+          ],
+        ),
+      ]),
+      bottomNavigationBar: SafeArea(
+        child: Padding(
+          padding: const EdgeInsets.all(16),
+          child: FilledButton(
+            key: const Key('batchStart'),
+            style: FilledButton.styleFrom(minimumSize: const Size.fromHeight(50)),
+            onPressed: _reading || ready == 0 ? null : _start,
+            child: Text(ready == 0 && !_reading ? s.t('batch.none_ready') : s.t('batch.start', {'n': ready})),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Runs the queue (PLAN §8.4). Not dismissible; stopping asks first.
+class BatchRunningScreen extends StatefulWidget {
+  const BatchRunningScreen({super.key, required this.inputs, required this.settings});
+  final List<BatchInput> inputs;
+  final ConvertSettings settings;
+  @override
+  State<BatchRunningScreen> createState() => _BatchRunningScreenState();
+}
+
+class _BatchRunningScreenState extends State<BatchRunningScreen> with WidgetsBindingObserver {
+  late final BatchRunner _runner;
+  late final AppState _state;
+  int? _backgroundTask;
+  bool _ended = false;
+
+  @override
+  void initState() {
+    super.initState();
+    final state = _state = AppScope.read(context);
+    _runner = BatchRunner(
+      engine: state.engine,
+      inputs: widget.inputs, // unreadable files end as failed, so totals match the selection
+      settings: widget.settings,
+      memoryGuard: state.memoryGuard,
+      budgetBytes: state.memoryBudgetBytes,
+      outputPathFor: state.outputPathFor,
+      isAllowed: () => state.batchLimit() == null,
+      onFileDone: (item, r) {
+        final bytes = File(r.outputPath).existsSync() ? File(r.outputPath).lengthSync() : 0;
+        state.recordConversion();
+        state.addHistory(HistoryEntry(
+          outputPath: r.outputPath,
+          format: widget.settings.format,
+          bytes: bytes,
+          time: DateTime.now(),
+          sourceName: item.input.name,
+          settings: widget.settings,
+        ));
+      },
+    )..addListener(_changed);
+    WidgetsBinding.instance.addObserver(this);
+    state.haptics.start();
+    // One background task for the whole batch.
+    state.background
+        .begin('stl2stp-convert', onExpire: () => _runner.stop(BatchStopReason.background))
+        .then((id) => _ended ? state.background.end(id) : _backgroundTask = id);
+    WidgetsBinding.instance.addPostFrameCallback((_) => _go());
+  }
+
+  void _changed() {
+    if (mounted) setState(() {});
+  }
+
+  Future<void> _go() async {
+    await _runner.run();
+    _ended = true;
+    final id = _backgroundTask;
+    _backgroundTask = null;
+    if (id != null) await _state.background.end(id);
+    if (_runner.summary.done > 0) {
+      _state.haptics.success();
+    } else {
+      _state.haptics.failure();
+    }
+    if (mounted) setState(() {});
+  }
+
+  @override
+  void didHaveMemoryPressure() => _runner.stop(BatchStopReason.memory);
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _runner.removeListener(_changed);
+    if (!_runner.finished) _runner.stop(BatchStopReason.cancelled);
+    final id = _backgroundTask;
+    if (id != null) _state.background.end(id);
+    _runner.dispose();
+    super.dispose();
+  }
+
+  Future<void> _askStop() async {
+    final s = S.of(context);
+    final t = Tokens.of(context);
+    final yes = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        title: Text(s.t('batch.cancel.title')),
+        content: Text(s.t('batch.cancel.body')),
+        actions: [
+          TextButton(
+              key: const Key('batchStopYes'),
+              onPressed: () => Navigator.pop(ctx, true),
+              child: Text(s.t('batch.cancel.yes'), style: TextStyle(color: t.danger))),
+          FilledButton(
+              style: FilledButton.styleFrom(minimumSize: const Size(64, 40)),
+              onPressed: () => Navigator.pop(ctx, false),
+              child: Text(s.t('batch.cancel.no'))),
+        ],
+      ),
+    );
+    if (yes == true) _runner.stop(BatchStopReason.cancelled);
+  }
+
+  String _reason(S s, BatchItem it) {
+    switch (it.state) {
+      case BatchItemState.skipped:
+        return s.t(it.reasonKey ?? 'batch.state.skipped');
+      case BatchItemState.notRun:
+        return s.t('batch.stop.${(it.stopReason ?? BatchStopReason.cancelled).name}');
+      case BatchItemState.failed:
+        final key = switch (it.status) {
+          CoreStatus.errorMemory => 'error.memory.title',
+          CoreStatus.errorEmpty => 'error.empty.title',
+          CoreStatus.errorFormat || CoreStatus.errorIo => 'error.format.title',
+          _ => 'error.generic.title',
+        };
+        return s.t(key);
+      default:
+        return '';
+    }
+  }
+
+  Future<void> _shareAll() async {
+    final s = S.of(context);
+    final messenger = ScaffoldMessenger.of(context);
+    final files = [for (final i in _runner.items) if (i.state == BatchItemState.done) XFile(i.result!.outputPath)];
+    if (files.isEmpty) return;
+    final box = context.findRenderObject();
+    final origin = box is RenderBox && box.hasSize ? box.localToGlobal(Offset.zero) & box.size : null;
+    try {
+      if (!(Platform.isIOS || Platform.isAndroid || Platform.isMacOS)) throw UnsupportedError('desktop');
+      await SharePlus.instance.share(ShareParams(files: files, sharePositionOrigin: origin));
+    } catch (_) {
+      messenger.showSnackBar(SnackBar(content: Text(s.t('x.share_unavailable'))));
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final s = S.of(context);
+    final t = Tokens.of(context);
+    final fin = _runner.finished;
+    final sum = _runner.summary;
+    final k = (_runner.currentIndex + 1).clamp(1, _runner.items.length);
+    return PopScope(
+      canPop: false,
+      child: Scaffold(
+        appBar: AppBar(title: Text(s.t('batch.title')), automaticallyImplyLeading: false),
+        body: SafeArea(
+          child: Column(children: [
+            Padding(
+              padding: const EdgeInsets.fromLTRB(16, 8, 16, 8),
+              child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+                Text(
+                    fin
+                        ? s.t('batch.summary', {
+                            'done': sum.done,
+                            'failed': sum.failed,
+                            'skipped': sum.skipped,
+                            'notRun': sum.notRun
+                          })
+                        : s.t('batch.progress', {'k': k, 'n': _runner.items.length}),
+                    key: const Key('batchStatus'),
+                    style: TextStyle(fontSize: 17, fontWeight: FontWeight.w600, color: t.label)),
+                const SizedBox(height: 8),
+                LinearProgressIndicator(value: _runner.overall),
+              ]),
+            ),
+            Expanded(
+              child: ListView(children: [
+                for (final it in _runner.items)
+                  ListTile(
+                    dense: true,
+                    leading: switch (it.state) {
+                      BatchItemState.done => Icon(Icons.check_circle, color: t.success),
+                      BatchItemState.failed => Icon(Icons.error, color: t.danger),
+                      BatchItemState.skipped => Icon(Icons.skip_next, color: t.warning),
+                      BatchItemState.notRun => Icon(Icons.remove_circle_outline, color: t.label3),
+                      BatchItemState.running => Icon(Icons.radio_button_checked, color: t.accent),
+                      BatchItemState.waiting => Icon(Icons.radio_button_unchecked, color: t.label3),
+                    },
+                    title: Text(it.input.name, maxLines: 1, overflow: TextOverflow.ellipsis),
+                    subtitle: Text(
+                        it.state == BatchItemState.running && it.stage != null
+                            ? '${s.t('batch.state.running')} · ${s.t('converting.stage.${it.stage!.name}')}'
+                            : [s.t('batch.state.${it.state.name}'), _reason(s, it)].where((e) => e.isNotEmpty).join(' · '),
+                        style: TextStyle(color: t.label2)),
+                  ),
+              ]),
+            ),
+            Padding(
+              padding: const EdgeInsets.all(16),
+              child: fin
+                  ? Column(children: [
+                      if (sum.done > 0)
+                        OutlinedButton(
+                            key: const Key('batchShareAll'),
+                            style: OutlinedButton.styleFrom(minimumSize: const Size.fromHeight(50)),
+                            onPressed: _shareAll,
+                            child: Text(s.t('batch.share_all'))),
+                      const SizedBox(height: 8),
+                      FilledButton(
+                          key: const Key('batchFinish'),
+                          style: FilledButton.styleFrom(minimumSize: const Size.fromHeight(50)),
+                          onPressed: () => Navigator.of(context).popUntil((r) => r.isFirst),
+                          child: Text(s.t('batch.finish'))),
+                    ])
+                  : SizedBox(
+                      width: double.infinity,
+                      child: TextButton.icon(
+                        key: const Key('batchStop'),
+                        style: TextButton.styleFrom(
+                            foregroundColor: t.danger, backgroundColor: t.fill, minimumSize: const Size.fromHeight(50)),
+                        onPressed: _askStop,
+                        icon: const Icon(Icons.stop_circle_outlined),
+                        label: Text(s.t('batch.cancel')),
+                      ),
+                    ),
+            ),
+          ]),
+        ),
+      ),
+    );
+  }
+}
diff --git a/mobile/app/lib/screens/flow.dart b/mobile/app/lib/screens/flow.dart
index c736c7c..fbaa262 100644
--- a/mobile/app/lib/screens/flow.dart
+++ b/mobile/app/lib/screens/flow.dart
@@ -48,6 +48,59 @@ Future<String?> pickStl(BuildContext context) async {
   }
 }
 
+/// Most files one batch may hold (PLAN §8.2).
+const maxBatchFiles = 50;
+
+/// FNV-1a over [bytes]; cheap content identity for picks that have no path.
+int _fnv(Uint8List bytes) {
+  var h = 0xcbf29ce484222325;
+  for (final b in bytes) {
+    h = ((h ^ b) * 0x100000001b3) & 0x7fffffffffffffff;
+  }
+  return h;
+}
+
+/// Turns picker results into local paths (see [pickStls]).
+@visibleForTesting
+Future<List<String>> materializePicked(List<PlatformFile> files, {Directory? tempRoot}) async {
+  final seen = <String>{};
+  final out = <String>[];
+  for (final f in files) {
+    final path = f.path;
+    if (path != null) {
+      if (seen.add('path:$path')) out.add(path);
+      continue;
+    }
+    final bytes = await f.readAsBytes();
+    if (!seen.add('data:${f.name}:${bytes.length}:${_fnv(bytes)}')) continue;
+    final dir = (tempRoot ?? Directory.systemTemp).createTempSync('stl2stp_batch_');
+    final tmp = File(p.join(dir.path, f.name));
+    await tmp.writeAsBytes(bytes, flush: true);
+    out.add(tmp.path);
+  }
+  return out;
+}
+
+/// Picks several STL files (PLAN §8.1, §14c P13). Every non-local result is
+/// copied into its own temp sub-directory under its original name, so equal
+/// names from different sources never collide. Duplicates are removed by
+/// source identity (local path, or name + size + content hash), never by the
+/// copied path. Returns an empty list when cancelled. Falls back to the path
+/// dialog (one file per call) when the picker is unavailable.
+Future<List<String>> pickStls(BuildContext context) async {
+  final s = S.of(context);
+  try {
+    final files = await FilePicker.pickFiles(type: FileType.custom, allowedExtensions: const ['stl', 'STL']);
+    final out = await materializePicked(files);
+    return out;
+  } catch (e) {
+    debugPrint('file picker failed: $e');
+    if (!context.mounted) return const [];
+    final one = await askPath(context, s.t('x.open_path.picker_failed'));
+    return one == null ? const [] : [one];
+  }
+}
+
 Future<String?> askPath(BuildContext context, String note) {
   final s = S.of(context);
   final c = TextEditingController();
