    23	/// Engine whose conversions finish only when the test says so.
    24	class GateEngine extends DemoEngine {
    25	  GateEngine() : super(stepDelay: Duration.zero);
    26	  final calls = <String>[];
    27	  final gates = <String, Completer<int>>{};
    28	  Completer<int> gate(String name) => gates.putIfAbsent(name, Completer<int>.new);
    29	  final failNames = <String>{};
    30	
    31	  @override
    32	  Future<ConvertResult> convert(ConvertRequest request,
    33	      {required void Function(ConvertProgress) onProgress, required CancelToken cancel}) async {
    34	    final name = request.inputPath.split('/').last;
    35	    calls.add(name);
    36	    if (failNames.contains(name)) return ConvertResult(status: CoreStatus.errorFormat, outputPath: request.outputPath, message: 'bad');
    37	    final g = gates[name];
    38	    if (g != null) {
    39	      final status = await g.future;
    40	      if (status == CoreStatus.ok && !cancel.isCancelled) File(request.outputPath).writeAsStringSync('x');
    41	      return ConvertResult(status: cancel.isCancelled && status != CoreStatus.ok ? CoreStatus.errorCancelled : status, outputPath: request.outputPath);
    42	    }
    43	    File(request.outputPath).writeAsStringSync('x');
    44	    return ConvertResult(status: CoreStatus.ok, outputPath: request.outputPath);
    45	  }
    46	}
    47	
    48	BatchInput _in(String name, [int? faces = 100]) => BatchInput(path: '/tmp/$name', name: name, size: 10, faces: faces);
    49	
    50	BatchRunner _runner(GateEngine e, List<BatchInput> ins, Directory out,
    51	    {bool Function()? allowed, int budget = 1 << 40, void Function(BatchItem, ConvertResult)? done}) {
    52	  var n = 0;
    53	  return BatchRunner(
    54	    engine: e,
    55	    inputs: ins,
    56	    settings: const ConvertSettings(),
    57	    memoryGuard: const MemoryGuard(),
    58	    budgetBytes: budget,
    59	    outputPathFor: (src, f) => '${out.path}/${n++}.${f.extension}',
    60	    onFileDone: done ?? (_, _) {},
    61	    isAllowed: allowed,
    62	  );
    63	}
