   242	      'max': [s.maximum[0], s.maximum[1], s.maximum[2]],
   243	    };
   244	  } finally {
   245	    calloc.free(stats);
   246	    calloc.free(cPath);
   247	    b.destroy(h);
   248	  }
   249	}
   250	
   251	// ---- worker isolate state (isolate-local globals used by C callbacks) ----
   252	SendPort? _wPort;
   253	int _wStage = 0;
   254	double _wLast = -1;
   255	int _wLastMs = 0;
   256	final Stopwatch _wClock = Stopwatch();
   257	Pointer<Int32> _wCancel = nullptr;
   258	
   259	/// Export callback covers both "build faces" and "write file"; split at 70 %.
   260	bool _wExportSplit = false;
   261	
   262	void _post(int stage, double f, {bool force = false}) {
   263	  final now = _wClock.elapsedMilliseconds;
   264	  if (!force && stage == _wStage && (f - _wLast).abs() < 0.01 && now - _wLastMs < 50) return;
   265	  _wStage = stage;
   266	  _wLast = f;
   267	  _wLastMs = now;
   268	  _wPort?.send({'t': 'p', 's': stage, 'f': f});
   269	}
   270	
   271	void _onProgress(double fraction, Pointer<Void> _) {
   272	  if (_wExportSplit) {
   273	    if (fraction < 0.7) {
   274	      _post(Stage.build.index, fraction / 0.7);
   275	    } else {
   276	      _post(Stage.write.index, (fraction - 0.7) / 0.3);
   277	    }
   278	  } else {
   279	    _post(_wStage, fraction);
   280	  }
   281	}
   282	
   283	int _onCancel(Pointer<Void> _) => _wCancel == nullptr ? 0 : (_wCancel.value != 0 ? 1 : 0);
   284	
   285	void _convertWorker(Map<String, Object?> a) {
   286	  _wPort = a['port'] as SendPort;
   287	  _wCancel = Pointer<Int32>.fromAddress(a['cancel'] as int);
   288	  _wClock.start();
   289	  final b = Stl2StpBindings(_open(a['lib'] as String?));
   290	  final warnings = <int>[];
   291	  final topo = calloc<Stl2StpTopology>();
   292	  final topo2 = calloc<Stl2StpTopology>();
   293	  final stats = calloc<Stl2StpMeshStats>();
   294	  final cb = calloc<Stl2StpCallbacks>();
   295	  final opt = calloc<Stl2StpExportOptions>();
   296	  final strings = <Pointer<Utf8>>[];
   297	  Pointer<Utf8> str(String s) {
   298	    final ptr = s.toNativeUtf8();
   299	    strings.add(ptr);
   300	    return ptr;
   301	  }
   302	
   303	  cb.ref
   304	    ..progress = Pointer.fromFunction<ProgressNative>(_onProgress)
   305	    ..cancelled = Pointer.fromFunction<CancelNative>(_onCancel, 0)
   306	    ..userData = nullptr;
   307	  final h = b.create();
   308	  int? facesAfter;
   309	  bool? verified;
   310	  void finish(int status, {int? failed, String error = ''}) {
   311	    _wPort!.send({
   312	      't': 'done',
   313	      'status': status,
   314	      'error': error,
   315	      'failed': failed,
   316	      'warnings': warnings,
   317	      'facesAfter': facesAfter,
   318	      'verified': verified,
   319	      'topo': [topo.ref.solids, topo.ref.shells, topo.ref.faces, topo.ref.edges, topo.ref.vertices],
   320	    });
   321	  }
   322	
   323	  int note(int st) {
   324	    if (st > 0 && !warnings.contains(st)) warnings.add(st);
   325	    return st;
   326	  }
   327	
   328	  try {
   329	    if (h == nullptr) return finish(CoreStatus.errorMemory, failed: Stage.read.index, error: 'create failed');
   330	    // 1. read
   331	    _post(Stage.read.index, 0, force: true);
   332	    var st = note(b.loadStl(h, str(a['in'] as String), cb));
   333	    if (st < 0) return finish(st, failed: Stage.read.index, error: b.errorOf(h));
   334	    _post(Stage.read.index, 1, force: true);
   335	    // 2. simplify (weld first so QEM sees closed seams; core/weld)
   336	    if (a['simplify'] == true) {
   337	      _post(Stage.simplify.index, 0, force: true);
   338	      if (a['weld'] == true) {
   339	        final merged = calloc<Uint64>();
   340	        try {
   341	          st = b.weldVertices(h, 0, merged);
   342	          if (st < 0) return finish(st, failed: Stage.simplify.index, error: b.errorOf(h));
   343	          if (merged.value > 0) note(CoreStatus.warningRepaired);
   344	        } finally {
   345	          calloc.free(merged);
   346	        }
   347	      }
   348	      st = note(b.simplify(h, a['target'] as int, cb));
   349	      if (st < 0) return finish(st, failed: Stage.simplify.index, error: b.errorOf(h));
   350	      if (b.getMeshStats(h, stats) >= 0) facesAfter = stats.ref.faces;
   351	      _post(Stage.simplify.index, 1, force: true);
   352	    }
   353	    // Free-tier limit on the mesh that will really be built (simplification
   354	    // can stop short of its target: TARGET_NOT_REACHED).
   355	    final maxFaces = a['maxFaces'] as int?;
   356	    if (maxFaces != null) {
   357	      if (b.getMeshStats(h, stats) >= 0) facesAfter = stats.ref.faces;
   358	      final real = facesAfter;
   359	      if (real != null && real > maxFaces) {
   360	        return finish(CoreStatus.errorFreeLimit,
   361	            failed: a['simplify'] == true ? Stage.simplify.index : Stage.read.index, error: 'faces=$real limit=$maxFaces');
   362	      }
   363	    }
   364	    // 3+4. build + write
   365	    final d = b.defaultExportOptions();
   366	    opt.ref
   367	      ..sewingTolerance = d.sewingTolerance
   368	      ..mergeCoplanar = a['merge'] == true ? 1 : 0
   369	      ..mode = a['mode'] as int
   370	      ..author = str(a['author'] as String)
   371	      ..organization = str(a['org'] as String)
   372	      ..product = str(a['product'] as String)
   373	      ..description = str(a['description'] as String)
   374	      ..timestamp = nullptr
   375	      ..mergeAngularTolerance = d.mergeAngularTolerance
   376	      ..strictOriginal = d.strictOriginal
   377	      ..weldVertices = a['weld'] == true ? 1 : 0
   378	      ..weldTolerance = d.weldTolerance;
   379	    _post(Stage.build.index, 0, force: true);
   380	    _wExportSplit = true;
   381	    final out = str(a['out'] as String);
   382	    st = note(a['format'] == 'iges' ? b.exportIges(h, out, opt, cb, topo) : b.exportStep(h, out, opt, cb, topo));
   383	    _wExportSplit = false;
   384	    if (st < 0) {
   385	      final failed = _wStage == Stage.write.index ? Stage.write.index : Stage.build.index;
   386	      return finish(st, failed: failed, error: b.errorOf(h));
   387	    }
   388	    final exportMsg = st > 0 ? b.errorOf(h) : '';
   389	    _post(Stage.write.index, 1, force: true);
   390	    // 5. verify (STEP only)
   391	    if (a['verify'] == true) {
   392	      _post(Stage.verify.index, 0, force: true);
   393	      final v = b.readStep(h, out, cb, topo2);
   394	      if (v == CoreStatus.errorCancelled) return finish(v, failed: Stage.verify.index, error: b.errorOf(h));
   395	      final notSolid = warnings.contains(CoreStatus.warningNotSolid);
   396	      verified = v >= 0 && topo2.ref.faces > 0 && (topo2.ref.solids >= 1 || notSolid);
   397	      _post(Stage.verify.index, 1, force: true);
   398	    }
   399	    final finalStatus = warnings.isEmpty ? CoreStatus.ok : warnings.first;
   400	    finish(finalStatus, error: exportMsg);
   401	  } catch (e) {
   402	    finish(CoreStatus.errorInternal, error: '$e');
   403	  } finally {
   404	    if (h != nullptr) b.destroy(h);
   405	    for (final s in strings) {
   406	      calloc.free(s);
   407	    }
   408	    calloc.free(topo);
   409	    calloc.free(topo2);
   410	    calloc.free(stats);
   411	    calloc.free(cb);
   412	    calloc.free(opt);
   413	  }
   414	}
import 'dart:io';
import 'dart:math' as math;

import 'package:flutter/foundation.dart';
import 'package:flutter/services.dart';

import 'models.dart';

/// Peak-memory pre-check before a conversion (ui-spec §2.2 "内存不足").
///
/// Model (bytes): peak = base + perFace · F, where F is the number of faces
/// built by OCCT (after simplification); sewing and coplanar merging hold
/// extra copies of the shape (×[sewingFactor] / ×[mergeFactor]); with
/// simplification the QEM pass on the full mesh can be the peak instead
/// (base + simplifyPerTriangle · n). Calibrated with `max RSS` of
/// stl2stp-cli on the dev PC (tool/calib/memtime.csv, docs/flutter-app.md):
/// ORIGINAL STEP 140 MB @ 5k, 437 MB @ 20k, 1016 MB @ 50k, 2017 MB @ 102k
/// triangles (≈19.4 kB/face + ~45 MB); sewing ≈ +5 %; coplanar merge and
/// IGES measured lower (kept at ×1.0, conservative); simplify 50 % follows
/// the output face count. [simplifyPerTriangle] is not separable in the
/// measurements and stays a conservative guess.
class MemoryGuard {
  const MemoryGuard({
    this.baseBytes = 50e6,
    this.perFace = 20.5e3,
    this.sewingFactor = 1.06,
    this.mergeFactor = 1.0,
    this.simplifyPerTriangle = 1.2e3,
    this.warnFraction = 0.7,
  });

  final double baseBytes;
  final double perFace;
  final double sewingFactor;
  final double mergeFactor;
  final double simplifyPerTriangle;

  /// Warn above this share of the budget, refuse above the full budget.
  final double warnFraction;

  int peakBytes(int triangles, ConvertSettings s) {
    final n = math.max(triangles, 0);
    final f = s.simplify ? s.targetFaces(n) : n;
    var build = perFace * f;
    if (s.mode == ConvertMode.sewing) build *= sewingFactor;
    if (s.mergeCoplanar) build *= mergeFactor;
    final qem = s.simplify ? simplifyPerTriangle * n : 0.0;
    return (baseBytes + math.max(build, qem)).round();
  }

  MemoryCheck check(int triangles, ConvertSettings s, int budgetBytes) {
    final need = peakBytes(triangles, s);
    final level = need > budgetBytes
        ? MemoryLevel.refuse
        : need > warnFraction * budgetBytes
            ? MemoryLevel.warn
            : MemoryLevel.ok;
    int? suggest;
    if (level != MemoryLevel.ok) {
      // Largest keep-percentage (step 5) that fits under the warning line.
      for (var p = 95; p >= 5; p -= 5) {
        if (peakBytes(triangles, s.copyWith(simplify: true, keepPercent: p)) <= warnFraction * budgetBytes) {
          suggest = p;
          break;
        }
      }
    }
    return MemoryCheck(level, need, budgetBytes, suggest);
  }
}

enum MemoryLevel { ok, warn, refuse }

class MemoryCheck {
  const MemoryCheck(this.level, this.needBytes, this.budgetBytes, this.suggestPercent);
  final MemoryLevel level;
  final int needBytes;
  final int budgetBytes;

  /// Keep-percentage that would fit, or null if even 5 % does not.
  final int? suggestPercent;
}

/// How much memory a conversion may use on this device.
///
/// Flutter has no portable API for this. Order: explicit override (Settings /
/// tests) → native `stl2stp/memory.available` (iOS: `os_proc_available_memory()`,
/// see docs/mac-setup-guide.md) → Linux `/proc/meminfo` MemAvailable → a
/// conservative default ([fallbackBytes], sized for a 4 GB iPhone whose
/// per-app limit is roughly half of RAM).
class MemoryBudget {
  static const fallbackBytes = 1500 * 1000 * 1000;
  static const channel = MethodChannel('stl2stp/memory');

  /// Share of the reported available memory a conversion may use.
  static const availableShare = 0.8;

  static Future<int> detect({int? overrideBytes}) async {
    if (overrideBytes != null && overrideBytes > 0) return overrideBytes;
    if (!kIsWeb && Platform.isIOS) {
      try {
        final v = await channel.invokeMethod<int>('available');
        if (v != null && v > 0) return (v * availableShare).round();
      } on MissingPluginException {
        // native side not installed yet
      } on PlatformException {
        // ignore
      }
      return fallbackBytes;
    }
    if (!kIsWeb && Platform.isLinux) {
      final v = linuxAvailable();
      if (v != null) return (v * availableShare).round();
    }
    return fallbackBytes;
  }

  /// MemAvailable from /proc/meminfo in bytes, or null.
  static int? linuxAvailable([String path = '/proc/meminfo']) {
    try {
      for (final line in File(path).readAsLinesSync()) {
        if (line.startsWith('MemAvailable:')) {
          final kb = int.tryParse(line.split(RegExp(r'\s+'))[1]);
          return kb == null ? null : kb * 1024;
        }
      }
    } catch (_) {}
    return null;
  }
}

