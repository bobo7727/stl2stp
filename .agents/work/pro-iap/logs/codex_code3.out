    52	
    53	  /// Opens the core, checks every symbol, and creates one handle so a library
    54	  /// that loads but cannot initialize is treated as a failure.
    55	  /// Returns null if the library cannot be found, opened, or initialized.
    56	  static FfiEngine? tryCreate() {
    57	    try {
    58	      final path = resolveCoreLibraryPath();
    59	      final bindings = Stl2StpBindings(path == null ? DynamicLibrary.process() : DynamicLibrary.open(path));
    60	      final handle = bindings.create();
    61	      if (handle == nullptr) {
    62	        final message = bindings.errorOf(nullptr);
    63	        throw StateError(message.isEmpty ? 'stl2stp_create failed' : message);
    64	      }
    65	      bindings.destroy(handle);
    66	      lastLoadError = null;
    67	      return FfiEngine._(path);
    68	    } catch (e) {
    69	      lastLoadError = e is StateError ? e.message : '$e';
    70	      return null;
    71	    }
    72	  }
