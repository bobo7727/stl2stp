   130	    final args = <String, Object?>{
   131	      'port': port.sendPort,
   132	      'lib': libraryPath,
   133	      'cancel': token.address,
   134	      'in': request.inputPath,
   135	      'out': request.outputPath,
   136	      'format': s.format.name,
   137	      'simplify': s.simplify,
   138	      'target': s.targetFaces(request.faces),
   139	      'mode': s.mode.value,
   140	      'merge': s.mergeCoplanar,
   141	      'verify': s.verifyEffective,
   142	      'weld': s.weld,
   143	      'maxFaces': request.maxFaces,
   144	      'author': meta(s.author),
   145	      'org': meta(s.organization),
   146	      'product': meta(s.product),
   147	      'description': meta(s.description),
   148	    };
   149	    port.listen((msg) {
   150	      final m = msg as Map;
   151	      if (m['t'] == 'p') {
   152	        final st = Stage.values[m['s'] as int];
   153	        final f = (m['f'] as double).clamp(0.0, 1.0);
   154	        onProgress(ConvertProgress(st, f, overallProgress(stages, st, f)));
   155	      } else if (m['t'] == 'done' && !done.isCompleted) {
   156	        sw.stop();
   157	        final topo = m['topo'] as List;
   158	        done.complete(ConvertResult(
   159	          status: m['status'] as int,
   160	          outputPath: request.outputPath,
   161	          message: m['error'] as String,
   162	          topology: Topology(
   163	              solids: topo[0] as int, shells: topo[1] as int, faces: topo[2] as int, edges: topo[3] as int,
   164	              vertices: topo[4] as int),
   165	          verified: m['verified'] as bool?,
   166	          facesAfterSimplify: m['facesAfter'] as int?,
   167	          warnings: (m['warnings'] as List).cast<int>(),
   168	          elapsed: sw.elapsed,
   169	          failedStage: m['failed'] == null ? null : Stage.values[m['failed'] as int],
   170	        ));
   171	      }
   172	    });
   173	    errPort.listen((e) {
   174	      if (!done.isCompleted) {
   175	        done.complete(ConvertResult(
   176	            status: CoreStatus.errorInternal, outputPath: request.outputPath, message: 'worker error: $e'));
   177	      }
   178	    });
   179	    exitPort.listen((_) {
   180	      if (!exited.isCompleted) exited.complete();
   181	      if (!done.isCompleted) {
   182	        done.complete(ConvertResult(
   183	            status: CoreStatus.errorInternal, outputPath: request.outputPath, message: 'worker exited'));
   184	      }
   185	    });
