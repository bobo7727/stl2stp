   187	    try {
   188	      final r = await done.future;
   189	      // The worker sends 'done' before it destroys the native handle and frees
   190	      // its buffers. Wait for the isolate to exit so a conversion is only
   191	      // "finished" once its native resources are released (batch runs the next
   192	      // file straight after this one).
   193	      // No timeout: returning early would let the next conversion start while
   194	      // this one's native handle and buffers still exist.
   195	      await resultAfterExit(Future.value(r), exited.future);
