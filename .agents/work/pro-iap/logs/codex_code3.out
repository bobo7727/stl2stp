    28	/// Shows the paywall until batch is allowed. A purchase is followed by a fresh
    29	/// check (§14c P10). Returns false when the user stays out.
    30	Future<bool> ensureBatchAllowed(BuildContext context) async {
    31	  for (var i = 0; i < 3; i++) {
    32	    final hit = AppScope.read(context).batchLimit();
    33	    if (hit == null) return true;
    34	    final r = await Navigator.push<PaywallResult>(context, MaterialPageRoute(builder: (_) => PaywallScreen(reason: hit)));
    35	    if (!context.mounted) return false;
    36	    if (r is! PaywallPurchased) return false;
    37	  }
    38	  return false;
    39	}
