   187	  // ---- outputs & history ----
   188	  String outputPathFor(String sourcePath, ExportFormat f) {
   189	    final dir = Directory(p.join(outputDir.path, 'Outputs'))..createSync(recursive: true);
   190	    final stem = p.basenameWithoutExtension(sourcePath);
   191	    var candidate = p.join(dir.path, '$stem.${f.extension}');
   192	    var i = 2;
   193	    while (File(candidate).existsSync()) {
   194	      candidate = p.join(dir.path, '$stem ($i).${f.extension}');
   195	      i++;
   196	    }
   197	    return candidate;
   198	  }
