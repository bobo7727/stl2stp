    49	
    50	/// Largest reduce percentage (multiple of 5, within the 5–95 % slider) that fits
    51	/// the free face limit, or null when even 5 % would not fit.
    52	int? freeReducePercent(int faces, {int limit = FreeTierLimits.freeMaxTriangles}) {
    53	  if (faces <= limit) return null;
    54	  final pct = (limit * 100 / faces).floor() ~/ 5 * 5;
    55	  return pct < 5 ? null : pct.clamp(5, 95);
    56	}
