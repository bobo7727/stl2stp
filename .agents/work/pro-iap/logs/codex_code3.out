    19	/// Home entry for batch conversion: checks the entitlement, then picks files
    20	/// and opens [BatchScreen] (PLAN §8.1).
    21	Future<void> startBatchFlow(BuildContext context) async {
    22	  if (!await ensureBatchAllowed(context) || !context.mounted) return;
    23	  final paths = await pickStls(context);
    24	  if (paths.isEmpty || !context.mounted) return;
    25	  await Navigator.of(context).push(MaterialPageRoute(builder: (_) => BatchScreen(paths: paths)));
    26	}
    27	
    28	/// Shows the paywall until batch is allowed. A purchase is followed by a fresh
    29	/// check (§14c P10). Returns false when the user stays out.
    30	Future<bool> ensureBatchAllowed(BuildContext context) async {
    31	  for (var i = 0; i < 3; i++) {
    32	    final hit = AppScope.read(context).batchLimit();
    33	    if (hit == null) return true;
    34	    final r = await Navigator.push<PaywallResult>(context, MaterialPageRoute(builder: (_) => PaywallScreen(reason: hit)));
    35	    if (!context.mounted) return false;
    36	    if (r is! PaywallPurchased) return false;
    37	  }
    38	  return false;
    39	}
    40	
    41	/// Setup page: file list, shared settings, start (PLAN §8.2).
    42	class BatchScreen extends StatefulWidget {
    43	  const BatchScreen({super.key, required this.paths});
    44	  final List<String> paths;
    45	  @override
    46	  State<BatchScreen> createState() => _BatchScreenState();
    47	}
    48	
    49	class _BatchScreenState extends State<BatchScreen> {
    50	  late List<BatchInput> _inputs;
    51	  bool _reading = true;
    52	  bool _inspecting = false;
    53	  final _inspected = <String>{};
    54	  bool _disposed = false;
    55	  bool _truncated = false;
    56	  late ConvertSettings _settings;
    57	  final _meta = List.generate(4, (_) => TextEditingController());
    58	
    59	  @override
    60	  void initState() {
    61	    super.initState();
    62	    final state = AppScope.read(context);
    63	    _inputs = [];
    64	    _add(widget.paths);
    65	    final base = state.initialSettings();
    66	    _settings = ConvertSettings.forPreset(Preset.recommended, format: base.format).copyWith(
    67	        author: base.author, organization: base.organization, product: base.product, description: base.description);
    68	    _meta[0].text = base.author;
    69	    _meta[1].text = base.organization;
    70	    _meta[2].text = base.product;
    71	    _meta[3].text = base.description;
    72	    WidgetsBinding.instance.addPostFrameCallback((_) => _inspectAll(state));
    73	  }
    74	
    75	  @override
    76	  void dispose() {
    77	    _disposed = true;
    78	    for (final c in _meta) {
    79	      c.dispose();
    80	    }
    81	    super.dispose();
    82	  }
    83	
    84	  /// Adds paths (de-duplicated, capped at [maxBatchFiles]); returns whether any were new.
    85	  bool _add(List<String> paths) {
    86	    var added = false;
    87	    for (final path in paths) {
    88	      if (_inputs.any((i) => i.path == path)) continue;
    89	      if (_inputs.length >= maxBatchFiles) {
    90	        _truncated = true;
    91	        break;
    92	      }
    93	      _inputs.add(BatchInput(path: path, name: p.basename(path), size: File(path).existsSync() ? File(path).lengthSync() : 0));
    94	      added = true;
    95	    }
    96	    return added;
    97	  }
