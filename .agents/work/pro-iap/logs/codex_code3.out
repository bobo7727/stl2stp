     9	/// iOS backend: native StoreKit 2 (ios/Runner/StoreCoordinator.swift) for the
    10	/// voluntary tip and the Pro non-consumable.
    11	///
    12	/// Pro truth lives natively (`Transaction.currentEntitlements`). `store.proActive`
    13	/// is only a cache of the last native answer so a cold start does not flash the
    14	/// paywall before the first native recompute; the native answer then replaces
    15	/// it, true or false (a refund while the app was closed turns it off).
    16	class IosStoreService extends PurchaseService implements TipService {
    17	  IosStoreService(this._prefs, {MethodChannel? method, EventChannel? events})
    18	      : _method = method ?? const MethodChannel('stl2stp/store'),
    19	        _events = events ?? const EventChannel('stl2stp/store/events');
    20	
    21	  static const _kPro = 'store.proActive';
    22	
    23	  final SharedPreferences _prefs;
    24	  final MethodChannel _method;
    25	  final EventChannel _events;
    26	
    27	  StreamSubscription<dynamic>? _sub;
    28	  final _background = StreamController<TipOutcome>.broadcast();
    29	  bool _started = false;
    30	  Future<void> _mirror = Future.value();
    31	  ProductInfo? _pro;
    32	  bool _buying = false;
    33	  TipLoad _load = TipLoad.idle;
    34	  List<TipProduct> _products = const [];
    35	
    36	  @override
    37	  bool get isPro => _prefs.getBool(_kPro) ?? false;
    38	  @override
    39	  bool get available => _started;
    40	  @override
    41	  ProductInfo? get product => _pro;
    42	  @override
    43	  bool get proForSale => true;
    44	  @override
    45	  bool get supported => true;
    46	  @override
    47	  TipLoad get loadState => _load;
    48	  @override
    49	  List<TipProduct> get products => _products;
    50	  @override
    51	  Stream<TipOutcome> get background => _background.stream;
    52	
    53	  @override
    54	  Future<void> init() async {
    55	    _sub ??= _events.receiveBroadcastStream().listen(_onEvent, onError: (Object _) {});
    56	    try {
    57	      final snap = await _method.invokeMapMethod<String, Object?>('start');
    58	      _started = true;
    59	      if (snap != null) _applyPro(snap);
    60	    } catch (_) {
    61	      // Store trouble must never block conversion.
    62	    }
    63	    notifyListeners();
    64	    await loadProducts();
    65	  }
    66	
    67	  @override
    68	  Future<void> loadProducts() async {
    69	    _load = TipLoad.loading;
    70	    notifyListeners();
    71	    try {
    72	      final r = await _method.invokeMapMethod<String, Object?>('loadProducts');
    73	      final canPay = r?['canPay'] != false;
    74	      final list = <TipProduct>[
    75	        for (final p in (r?['tips'] as List? ?? const []))
    76	          if (p is Map && p['id'] is String && p['price'] is String)
    77	            TipProduct(
    78	                id: p['id'] as String,
    79	                title: '${p['title'] ?? ''}',
    80	                description: '${p['description'] ?? ''}',
    81	                priceLabel: p['price'] as String),
    82	      ];
    83	      _products = list;
    84	      final pro = r?['pro'];
    85	      _pro = pro is Map && pro['id'] is String && pro['price'] is String
    86	          ? ProductInfo(
    87	              id: pro['id'] as String,
    88	              title: '${pro['title'] ?? ''}',
    89	              description: '${pro['description'] ?? ''}',
    90	              priceLabel: pro['price'] as String)
    91	          : null;
    92	      _load = canPay && list.isNotEmpty ? TipLoad.ready : TipLoad.unavailable;
    93	    } catch (_) {
    94	      _products = const [];
    95	      _pro = null;
    96	      _load = TipLoad.unavailable;
    97	    }
    98	    notifyListeners();
    99	  }
