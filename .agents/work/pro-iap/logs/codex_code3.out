   245	
   246	bool load_binary(std::istream& stream, uint64_t size, uint32_t declared,
   247	                 MeshBuilder& builder, Progress& progress) {
   248	    const uint64_t available = (size - 84) / 50;
   249	    const uint64_t count = std::min<uint64_t>(available, declared);
   250	    stream.seekg(84);
   251	    for (uint64_t index = 0; index < count; ++index) {
   252	        std::array<unsigned char, 50> record{};
   253	        if (!stream.read(reinterpret_cast<char*>(record.data()), record.size())) {
   254	            return true;
   255	        }
   256	        std::array<Point, 3> points{};
   257	        for (std::size_t corner = 0; corner < 3; ++corner) {
   258	            const unsigned char* coordinates = record.data() + 12 + corner * 12;
   259	            points[corner] = {decode_float(coordinates), decode_float(coordinates + 4),
   260	                              decode_float(coordinates + 8)};
   261	        }
   262	        builder.add(points);
   263	        if (index % 256 == 0) {
   264	            progress.report(0.99 * double(index + 1) / double(count));
   265	        }
   266	    }
   267	    return declared != available || size != 84 + uint64_t(declared) * 50;
   268	}
   269	
   270	bool load_ascii(std::istream& stream, uint64_t size, MeshBuilder& builder, Progress& progress) {
   271	    stream.imbue(std::locale::classic());
   272	    skip_stl_preamble(stream);
   273	    if (!keyword(stream, "solid")) {
   274	        throw Error(STL2STP_ERROR_FORMAT, "Expected ASCII STL solid header");
   275	    }
   276	    std::string line;
   277	    std::getline(stream, line);
   278	    bool closed = false;
   279	    std::string token;
   280	    std::size_t count = 0;
   281	    while (stream >> token) {
   282	        token = lowercase(token);
   283	        if (token == "endsolid") {
   284	            closed = true;
   285	            std::getline(stream, line);
   286	            if (!(stream >> token)) {
   287	                break;
   288	            }
   289	            if (lowercase(token) != "solid") {
   290	                return true;
   291	            }
   292	            std::getline(stream, line);
   293	            closed = false;
   294	            continue;
   295	        }
   296	        std::array<Point, 3> points{};
   297	        Point ignored_normal;
   298	        if (token != "facet" || !keyword(stream, "normal") || !read_point(stream, ignored_normal) ||
   299	            !keyword(stream, "outer") || !keyword(stream, "loop")) {
   300	            return true;
   301	        }
   302	        for (Point& point : points) {
   303	            if (!keyword(stream, "vertex") || !read_point(stream, point)) {
   304	                return true;
   305	            }
   306	        }
   307	        if (!keyword(stream, "endloop") || !keyword(stream, "endfacet")) {
   308	            return true;
   309	        }
   310	        builder.add(points);
   311	        if (++count % 256 == 0) {
   312	            const auto position = stream.tellg();
   313	            if (position >= 0) {
   314	                progress.report(0.99 * double(position) / double(size));
   315	            } else {
   316	                progress.check();
   317	            }
   318	        }
   319	    }
   320	    return !closed;
   321	}
