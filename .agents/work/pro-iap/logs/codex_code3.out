    83	  @override
    84	  Future<MeshInfo> inspect(String path) async {
    85	    final lib = libraryPath;
    86	    final r = await Isolate.run(() => _inspectWorker(lib, path));
    87	    if (r['status'] as int < 0) throw LoadException(r['status'] as int, r['error'] as String);
    88	    final file = File(path);
    89	    final size = file.lengthSync();
    90	    final raf = file.openSync();
    91	    final head = raf.readSync(size < 84 ? size : 84);
    92	    raf.closeSync();
    93	    // Binary check needs the size: replicate looksAscii with a size-aware header.
    94	    final isAscii = _isAsciiHeader(head, size);
    95	    return MeshInfo(
    96	      path: path,
    97	      fileName: p.basename(path),
    98	      fileSize: size,
    99	      faces: r['faces'] as int,
   100	      vertices: r['vertices'] as int,
   101	      edges: r['edges'] as int,
   102	      min: (r['min'] as List).cast<double>(),
   103	      max: (r['max'] as List).cast<double>(),
   104	      isAscii: isAscii,
   105	    );
   106	  }
   107	
   108	  static bool _isAsciiHeader(List<int> head, int size) {
   109	    if (head.length >= 84) {
   110	      final n = head[80] | head[81] << 8 | head[82] << 16 | head[83] << 24;
   111	      if (84 + 50 * n == size) return false;
   112	    }
   113	    return looksAscii(Uint8List.fromList(head));
   114	  }
