   236	class AppScope extends InheritedNotifier<AppState> {
   237	  const AppScope({super.key, required AppState state, required super.child}) : super(notifier: state);
   238	
   239	  static AppState of(BuildContext context) => context.dependOnInheritedWidgetOfExactType<AppScope>()!.notifier!;
   240	  static AppState read(BuildContext context) =>
   241	      (context.getElementForInheritedWidgetOfExactType<AppScope>()!.widget as AppScope).notifier!;
   242	}
