   211	/// Completes with [result] only once the worker isolate has exited, i.e. its
   212	/// native handle and buffers are freed. There is deliberately no timeout: a
   213	/// timeout would report "finished" while cleanup is still outstanding.
   214	@visibleForTesting
   215	Future<T> resultAfterExit<T>(Future<T> result, Future<void> exited) async {
   216	  final r = await result;
   217	  await exited;
   218	  return r;
   219	}
