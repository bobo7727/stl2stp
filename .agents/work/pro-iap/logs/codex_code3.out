    59	/// store's own display price. Pops with a [PaywallResult].
    60	class PaywallScreen extends StatefulWidget {
    61	  const PaywallScreen({super.key, this.reason, this.faces, this.settings});
    62	
    63	  /// The free-tier limit that triggered the paywall, if any.
