   224	/// Share via the system share sheet; desktop fallback copies the path.
   225	///
   226	/// iOS/Android/macOS: system share sheet via share_plus. iPad requires an
   227	/// anchor rect for the popover; when [origin] is null the calling widget's
   228	/// bounds are used. Linux/Windows: no share sheet, the path is copied.
   229	Future<void> shareFile(BuildContext context, String path, {Rect? origin}) async {
   230	  final s = S.of(context);
   231	  final messenger = ScaffoldMessenger.of(context);
   232	  if (origin == null) {
   233	    final box = context.findRenderObject();
   234	    if (box is RenderBox && box.hasSize) origin = box.localToGlobal(Offset.zero) & box.size;
   235	  }
   236	  try {
   237	    if (!(Platform.isIOS || Platform.isAndroid || Platform.isMacOS)) throw UnsupportedError('desktop');
   238	    await SharePlus.instance.share(ShareParams(files: [XFile(path)], sharePositionOrigin: origin));
   239	  } catch (_) {
   240	    await Clipboard.setData(ClipboardData(text: path));
   241	    messenger.showSnackBar(SnackBar(content: Text('${s.t('x.share_unavailable')}\n$path')));
   242	  }
   243	}
   244	
   245	/// "存到“文件”": system save dialog with the file bytes.
   246	Future<void> saveToFiles(BuildContext context, String path) async {
   247	  final s = S.of(context);
   248	  final messenger = ScaffoldMessenger.of(context);
   249	  try {
   250	    final bytes = await File(path).readAsBytes();
   251	    final uri = await FilePicker.saveFile(fileName: p.basename(path), bytes: bytes);
   252	    if (uri != null) {
   253	      messenger.showSnackBar(SnackBar(content: Text(s.t('x.saved_to', {'path': uri.toFilePath()}))));
   254	    }
   255	  } catch (e) {
   256	    await Clipboard.setData(ClipboardData(text: path));
   257	    messenger.showSnackBar(SnackBar(content: Text('${s.t('x.output_path')}: $path (${s.t('x.copied')})')));
   258	  }
   259	}
   260	
   261	String historySubtitle(BuildContext context, HistoryEntry e) {
   262	  final now = DateTime.now();
   263	  final t = e.time;
   264	  final hm = '${t.hour.toString().padLeft(2, '0')}:${t.minute.toString().padLeft(2, '0')}';
   265	  final sameDay = t.year == now.year && t.month == now.month && t.day == now.day;
   266	  final date = sameDay ? hm : '${t.month}/${t.day} $hm';
   267	  return '$date · ${formatBytes(e.bytes)}';
   268	}
