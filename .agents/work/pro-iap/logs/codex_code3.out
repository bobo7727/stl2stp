    64	
    65	  final ExportFormat format;
    66	  final bool simplify;
    67	
    68	  /// 5..95, step 5.
    69	  final int keepPercent;
    70	  final ConvertMode mode;
    71	  final bool mergeCoplanar;
    72	  final bool verify;
    73	
    74	  /// Join near-coincident vertices (core/weld, default on). Off = exact
    75	  /// coordinate joining like the desktop original.
    76	  final bool weld;
    77	  final String author;
    78	  final String organization;
    79	  final String product;
    80	  final String description;
    81	
    82	  static ConvertSettings forPreset(Preset p, {ExportFormat format = ExportFormat.step}) {
    83	    switch (p) {
    84	      case Preset.recommended:
    85	        return ConvertSettings(format: format);
    86	      case Preset.smaller:
    87	        return ConvertSettings(format: format, simplify: true, keepPercent: 50, mergeCoplanar: true);
    88	      case Preset.strict:
    89	        return ConvertSettings(format: format, mode: ConvertMode.sewing);
    90	    }
    91	  }
    92	
    93	  /// The preset these settings correspond to, or null for "custom".
    94	  /// Metadata and format do not affect the preset.
    95	  Preset? get preset {
    96	    for (final p in Preset.values) {
    97	      final ref = ConvertSettings.forPreset(p);
    98	      if (ref.simplify == simplify &&
    99	          (!simplify || ref.keepPercent == keepPercent) &&
   100	          ref.mode == mode &&
   101	          ref.mergeCoplanar == mergeCoplanar &&
   102	          ref.verify == verify &&
   103	          ref.weld == weld) {
   104	        return p;
   105	      }
   106	    }
   107	    return null;
   108	  }
   109	
   110	  /// Applies a preset but keeps format and metadata.
   111	  ConvertSettings withPreset(Preset p) {
   112	    final ref = ConvertSettings.forPreset(p, format: format);
   113	    return ref.copyWith(
   114	        author: author, organization: organization, product: product, description: description);
   115	  }
   116	
   117	  bool get hasNonAsciiMeta =>
   118	      [author, organization, product, description].any((s) => s.runes.any((r) => r > 0x7e || r < 0x20));
   119	
   120	  bool get verifyEffective => verify && format == ExportFormat.step;
   121	
   122	  int targetFaces(int faces) => (faces * keepPercent / 100).round().clamp(1, faces < 1 ? 1 : faces);
   123	
   124	  ConvertSettings copyWith({
   125	    ExportFormat? format,
   126	    bool? simplify,
   127	    int? keepPercent,
   128	    ConvertMode? mode,
   129	    bool? mergeCoplanar,
   130	    bool? verify,
   131	    bool? weld,
   132	    String? author,
   133	    String? organization,
   134	    String? product,
   135	    String? description,
   136	  }) {
   137	    return ConvertSettings(
   138	      format: format ?? this.format,
   139	      simplify: simplify ?? this.simplify,
   140	      keepPercent: keepPercent ?? this.keepPercent,
   141	      mode: mode ?? this.mode,
   142	      mergeCoplanar: mergeCoplanar ?? this.mergeCoplanar,
   143	      verify: verify ?? this.verify,
   144	      weld: weld ?? this.weld,
   145	      author: author ?? this.author,
   146	      organization: organization ?? this.organization,
   147	      product: product ?? this.product,
   148	      description: description ?? this.description,
   149	    );
   150	  }
