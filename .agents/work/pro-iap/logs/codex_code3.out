   140	    final state = AppScope.read(context);
   141	    final settings = _final;
   142	    state.rememberSettings(settings);
   143	    await Navigator.of(context).pushReplacement(MaterialPageRoute(
   144	        builder: (_) => BatchRunningScreen(inputs: _inputs, settings: settings)));
   145	  }
