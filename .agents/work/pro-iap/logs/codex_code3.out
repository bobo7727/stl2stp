   221	DynamicLibrary _open(String? path) => path == null ? DynamicLibrary.process() : DynamicLibrary.open(path);
   222	
   223	Map<String, Object?> _inspectWorker(String? lib, String path) {
   224	  final b = Stl2StpBindings(_open(lib));
   225	  final h = b.create();
   226	  if (h == nullptr) return {'status': CoreStatus.errorMemory, 'error': 'create failed'};
   227	  final cPath = path.toNativeUtf8();
   228	  final stats = calloc<Stl2StpMeshStats>();
   229	  try {
   230	    var st = b.loadStl(h, cPath, nullptr);
   231	    if (st < 0) return {'status': st, 'error': b.errorOf(h)};
   232	    st = b.getMeshStats(h, stats);
   233	    if (st < 0) return {'status': st, 'error': b.errorOf(h)};
   234	    final s = stats.ref;
   235	    return {
   236	      'status': st,
   237	      'error': '',
   238	      'faces': s.faces,
   239	      'vertices': s.vertices,
   240	      'edges': s.edges,
