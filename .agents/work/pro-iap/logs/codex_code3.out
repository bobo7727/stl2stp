    17	/// Cancel flag in native memory so the C cancel callback (running inside the
    18	/// worker isolate, which is blocked in FFI) can read it without messages.
    19	class NativeCancelToken implements CancelToken {
    20	  NativeCancelToken() : _flag = calloc<Int32>();
    21	  final Pointer<Int32> _flag;
    22	  bool _disposed = false;
    23	  int get address => _flag.address;
    24	  @override
    25	  bool get isCancelled => !_disposed && _flag.value != 0;
    26	  @override
    27	  void cancel() {
    28	    if (!_disposed) _flag.value = 1;
    29	  }
    30	
    31	  @override
    32	  void dispose() {
    33	    if (_disposed) return;
    34	    _disposed = true;
    35	    calloc.free(_flag);
    36	  }
    37	}
