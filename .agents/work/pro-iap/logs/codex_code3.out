    51	  MemoryCheck check(int triangles, ConvertSettings s, int budgetBytes) {
    52	    final need = peakBytes(triangles, s);
    53	    final level = need > budgetBytes
    54	        ? MemoryLevel.refuse
    55	        : need > warnFraction * budgetBytes
    56	            ? MemoryLevel.warn
    57	            : MemoryLevel.ok;
    58	    int? suggest;
    59	    if (level != MemoryLevel.ok) {
    60	      // Largest keep-percentage (step 5) that fits under the warning line.
    61	      for (var p = 95; p >= 5; p -= 5) {
    62	        if (peakBytes(triangles, s.copyWith(simplify: true, keepPercent: p)) <= warnFraction * budgetBytes) {
    63	          suggest = p;
    64	          break;
    65	        }
    66	      }
    67	    }
    68	    return MemoryCheck(level, need, budgetBytes, suggest);
    69	  }
    70	}
