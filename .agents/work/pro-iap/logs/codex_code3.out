    11	/// Shows a purchase/restore result as a snackbar. Returns true if Pro is now unlocked.
    12	bool showPurchaseResult(BuildContext context, PurchaseResult r) {
    13	  final s = S.of(context);
    14	  final msg = switch (r.outcome) {
    15	    PurchaseOutcome.success => s.t('pro.success'),
    16	    PurchaseOutcome.restored => s.t('pro.restored'),
    17	    PurchaseOutcome.nothingToRestore => s.t('pro.nothing_to_restore'),
    18	    PurchaseOutcome.cancelled => s.t('pro.cancelled'),
    19	    PurchaseOutcome.pending => s.t('pro.pending'),
    20	    PurchaseOutcome.unavailable => s.t('pro.unavailable'),
    21	    PurchaseOutcome.unverified => s.t('pro.unverified'),
    22	    PurchaseOutcome.failed => s.t('pro.failed', {'msg': r.message ?? ''}),
    23	    PurchaseOutcome.busy => null,
    24	  };
    25	  if (msg != null) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(msg)));
    26	  return r.unlocked;
    27	}
