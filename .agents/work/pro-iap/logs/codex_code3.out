    41	  int peakBytes(int triangles, ConvertSettings s) {
    42	    final n = math.max(triangles, 0);
    43	    final f = s.simplify ? s.targetFaces(n) : n;
    44	    var build = perFace * f;
    45	    if (s.mode == ConvertMode.sewing) build *= sewingFactor;
    46	    if (s.mergeCoplanar) build *= mergeFactor;
    47	    final qem = s.simplify ? simplifyPerTriangle * n : 0.0;
    48	    return (baseBytes + math.max(build, qem)).round();
    49	  }
