   329	stl2stp_handle* stl2stp_create(void) {
   330	    try {
   331	        stl2stp::thread_error.clear();
   332	        return new stl2stp_handle;
   333	    } catch (...) {
   334	        try { stl2stp::thread_error = "Cannot allocate handle"; } catch (...) {}
   335	        return nullptr;
   336	    }
   337	}
   338	
   339	void stl2stp_destroy(stl2stp_handle* handle) { delete handle; }
   340	
   341	const char* stl2stp_last_error(const stl2stp_handle* handle) {
   342	    return handle ? handle->error.c_str() : stl2stp::thread_error.c_str();
   343	}
   344	
   345	stl2stp_export_options stl2stp_default_export_options(void) {
   346	    return {1e-6, 0, STL2STP_MODE_ORIGINAL, nullptr, nullptr, nullptr, nullptr, nullptr, 1e-4, 0, 1, 0.0};
   347	}
   348	
   349	stl2stp_status stl2stp_load_stl(stl2stp_handle* handle, const char* path,
   350	                               const stl2stp_callbacks* callbacks) {
   351	    return stl2stp::protect(handle, [&] {
   352	        stl2stp::require_path(path);
   353	        stl2stp::Progress progress(callbacks);
   354	        progress.report(0);
   355	        std::ifstream stream(std::filesystem::u8path(path), std::ios::binary);
   356	        if (!stream) {
   357	            throw stl2stp::Error(STL2STP_ERROR_IO, "Cannot open STL input");
   358	        }
   359	        stream.seekg(0, std::ios::end);
   360	        const auto length = stream.tellg();
   361	        if (length < 0) {
   362	            throw stl2stp::Error(STL2STP_ERROR_IO, "Cannot determine STL length");
   363	        }
   364	        const uint64_t size = static_cast<uint64_t>(length);
   365	        if (!size) {
   366	            throw stl2stp::Error(STL2STP_ERROR_FORMAT, "Empty STL file");
   367	        }
   368	        stream.seekg(0);
   369	        uint32_t declared = 0;
   370	        stl2stp::MeshBuilder builder;
   371	        const bool partial = stl2stp::binary_format(stream, size, declared)
   372	            ? stl2stp::load_binary(stream, size, declared, builder, progress)
   373	            : stl2stp::load_ascii(stream, size, builder, progress);
   374	        if (stream.bad()) {
   375	            throw stl2stp::Error(STL2STP_ERROR_IO, "Failed reading STL input");
   376	        }
   377	        if (builder.mesh.triangles.empty() && !builder.has_original_triangle) {
   378	            throw stl2stp::Error(STL2STP_ERROR_FORMAT, "No complete non-degenerate STL triangles");
   379	        }
   380	        if (partial || builder.skipped) {
   381	            handle->error = "Loaded complete triangles only: truncated/malformed data or degenerate facets";
   382	        }
   383	        progress.report(1);
   384	        builder.mesh.original_weld_required = true;
   385	        handle->mesh = std::move(builder.mesh);
   386	        return partial || builder.skipped ? STL2STP_WARNING_PARTIAL : STL2STP_OK;
   387	    });
   388	}
   389	
   390	stl2stp_status stl2stp_get_mesh_stats(stl2stp_handle* handle, stl2stp_mesh_stats* stats) {
   391	    return stl2stp::protect(handle, [&] {
   392	        if (!stats) {
   393	            throw stl2stp::Error(STL2STP_ERROR_ARGUMENT, "Null mesh statistics output");
   394	        }
   395	        stl2stp::require_mesh(handle->mesh);
   396	        stl2stp_mesh_stats result{};
   397	        result.vertices = handle->mesh.points.size();
   398	        result.faces = handle->mesh.triangles.size();
   399	        std::set<std::pair<std::size_t, std::size_t>> edges;
   400	        for (const auto& triangle : handle->mesh.triangles) {
   401	            for (std::size_t corner = 0; corner < 3; ++corner) {
   402	                const auto first = triangle[corner];
   403	                const auto second = triangle[(corner + 1) % 3];
   404	                edges.emplace(std::min(first, second), std::max(first, second));
   405	            }
   406	        }
   407	        result.edges = edges.size();
   408	        std::fill(std::begin(result.minimum), std::end(result.minimum), std::numeric_limits<double>::infinity());
   409	        std::fill(std::begin(result.maximum), std::end(result.maximum), -std::numeric_limits<double>::infinity());
   410	        for (const auto& point : handle->mesh.points) {
   411	            const double coordinates[] = {point.coordinate_x, point.coordinate_y, point.coordinate_z};
   412	            for (std::size_t axis = 0; axis < 3; ++axis) {
   413	                result.minimum[axis] = std::min(result.minimum[axis], coordinates[axis]);
   414	                result.maximum[axis] = std::max(result.maximum[axis], coordinates[axis]);
   415	            }
   416	        }
   417	        *stats = result;
   418	        return STL2STP_OK;
   419	    });
   420	}
   421	
   422	stl2stp_status stl2stp_simplify(stl2stp_handle* handle, uint64_t target_faces,
   423	                               const stl2stp_callbacks* callbacks) {
   424	    return stl2stp::protect(handle, [&] {
   425	        stl2stp::require_mesh(handle->mesh);
   426	        if (!target_faces || target_faces > std::numeric_limits<std::size_t>::max()) {
   427	            throw stl2stp::Error(STL2STP_ERROR_ARGUMENT, "Target face count must be positive and addressable");
   428	        }
   429	        if (handle->mesh.triangles.empty()) {
   430	            throw stl2stp::Error(STL2STP_ERROR_FORMAT, "No non-collinear triangles for simplification");
   431	        }
   432	        stl2stp::Progress progress(callbacks);
   433	        progress.report(0);
   434	        if (target_faces >= handle->mesh.triangles.size()) {
   435	            progress.report(1);
   436	            return STL2STP_OK;
   437	        }
   438	        auto result = stl2stp::simplify_mesh(handle->mesh, static_cast<std::size_t>(target_faces), progress);
   439	        const bool reached = result.triangles.size() <= target_faces;
   440	        if (!reached) {
   441	            handle->error = "QEM stopped before target: remaining collapses would break manifold topology or fold faces";
   442	        }
   443	        progress.report(1);
   444	        handle->mesh = std::move(result);
   445	        return reached ? STL2STP_OK : STL2STP_WARNING_TARGET_NOT_REACHED;
   446	    });
   447	}
