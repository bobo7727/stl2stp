   251	
   252	class _BatchRunningScreenState extends State<BatchRunningScreen> with WidgetsBindingObserver {
   253	  late final BatchRunner _runner;
   254	  late final AppState _state;
   255	  int? _backgroundTask;
   256	  bool _ended = false;
   257	
   258	  @override
   259	  void initState() {
   260	    super.initState();
   261	    final state = _state = AppScope.read(context);
   262	    _runner = BatchRunner(
   263	      engine: state.engine,
   264	      inputs: widget.inputs, // unreadable files end as failed, so totals match the selection
   265	      settings: widget.settings,
   266	      memoryGuard: state.memoryGuard,
   267	      budgetBytes: state.memoryBudgetBytes,
   268	      outputPathFor: state.outputPathFor,
   269	      isAllowed: () => state.batchLimit() == null,
   270	      maxFacesNow: () => state.isPro ? null : state.limits.maxTriangles,
   271	      onFileDone: (item, r) {
   272	        final bytes = File(r.outputPath).existsSync() ? File(r.outputPath).lengthSync() : 0;
   273	        state.recordConversion();
   274	        state.addHistory(HistoryEntry(
   275	          outputPath: r.outputPath,
   276	          format: widget.settings.format,
   277	          bytes: bytes,
   278	          time: DateTime.now(),
   279	          sourceName: item.input.name,
   280	          settings: widget.settings,
   281	        ));
   282	      },
   283	    )..addListener(_changed);
   284	    WidgetsBinding.instance.addObserver(this);
   285	    state.haptics.start();
   286	    // One background task for the whole batch.
   287	    state.background
   288	        .begin('stl2stp-convert', onExpire: () => _runner.stop(BatchStopReason.background))
   289	        .then((id) => _ended ? state.background.end(id) : _backgroundTask = id);
   290	    WidgetsBinding.instance.addPostFrameCallback((_) => _go());
   291	  }
   292	
   293	  void _changed() {
   294	    if (mounted) setState(() {});
   295	  }
   296	
   297	  Future<void> _go() async {
   298	    try {
   299	      await _runner.run();
   300	    } catch (e) {
   301	      debugPrint('batch run failed: $e');
   302	    }
   303	    _ended = true;
   304	    final id = _backgroundTask;
   305	    _backgroundTask = null;
   306	    if (id != null) await _state.background.end(id);
   307	    if (_runner.summary.done > 0) {
   308	      _state.haptics.success();
   309	    } else {
   310	      _state.haptics.failure();
   311	    }
   312	    if (mounted) setState(() {});
   313	  }
   314	
   315	  @override
   316	  void didHaveMemoryPressure() => _runner.stop(BatchStopReason.memory);
   317	
   318	  @override
   319	  void dispose() {
   320	    WidgetsBinding.instance.removeObserver(this);
   321	    _runner.removeListener(_changed);
   322	    if (!_runner.finished) _runner.stop(BatchStopReason.cancelled);
   323	    final id = _backgroundTask;
   324	    if (id != null) _state.background.end(id);
   325	    _runner.dispose();
   326	    super.dispose();
   327	  }
