    74	class _PaywallScreenState extends State<PaywallScreen> {
    75	  bool _busy = false;
    76	  String? _busyLabel;
    77	
    78	  @override
    79	  void initState() {
    80	    super.initState();
    81	    // After the first frame: init() notifies listeners, which must not happen during build.
    82	    WidgetsBinding.instance.addPostFrameCallback((_) {
    83	      if (!mounted) return;
    84	      final p = AppScope.read(context).purchase;
    85	      if (p.product == null) p.init().catchError((Object _) {});
    86	    });
    87	  }
    88	
    89	  Future<void> _run(Future<PurchaseResult> Function() action, String label) async {
    90	    setState(() {
    91	      _busy = true;
    92	      _busyLabel = label;
    93	    });
    94	    PurchaseResult r;
    95	    try {
    96	      r = await action();
    97	    } catch (e) {
    98	      r = PurchaseResult(PurchaseOutcome.failed, '$e');
    99	    }
   100	    if (!mounted) return;
   101	    setState(() => _busy = false);
   102	    if (showPurchaseResult(context, r)) Navigator.pop(context, const PaywallPurchased());
   103	  }
   104	
   105	  /// Free alternative for this trigger, or null (see PLAN §5): never offered
   106	  /// when it could not actually satisfy the limits.
   107	  ({String labelKey, Map<String, Object?> params, ConvertSettings settings})? _freeOption() {
   108	    final reason = widget.reason, faces = widget.faces, cur = widget.settings;
   109	    if (reason == null || faces == null || cur == null) return null;
   110	    if (reason.kind == LimitKind.triangles) {
   111	      final pct = freeReducePercent(faces, limit: reason.limit);
   112	      if (pct == null) return null;
   113	      final toStep = cur.format == ExportFormat.iges;
   114	      return (
   115	        labelKey: toStep ? 'pro.reduce.step' : 'pro.reduce',
   116	        params: {'percent': pct},
   117	        settings: cur.copyWith(format: ExportFormat.step, simplify: true, keepPercent: pct),
   118	      );
   119	    }
   120	    if (reason.kind == LimitKind.iges) {
   121	      return (labelKey: 'pro.use_step', params: const {}, settings: cur.copyWith(format: ExportFormat.step));
   122	    }
   123	    return null;
   124	  }
