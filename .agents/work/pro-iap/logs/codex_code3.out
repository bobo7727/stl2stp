    99	  Future<void> _addMore() async {
   100	    final paths = await pickStls(context);
   101	    if (!mounted || paths.isEmpty) return;
   102	    if (_add(paths)) {
   103	      setState(() => _reading = true);
   104	      _inspectAll(AppScope.read(context));
   105	    } else {
   106	      setState(() {});
   107	    }
   108	  }
   109	
   110	  /// One at a time; stops as soon as the page is left (§14c P12). Safe to call
   111	  /// again after files were added: only new files are read, never two loops at once.
   112	  Future<void> _inspectAll(AppState state) async {
   113	    if (_inspecting) return;
   114	    _inspecting = true;
   115	    for (var i = 0; i < _inputs.length; i++) {
   116	      if (_disposed) return;
   117	      if (!_inspected.add(_inputs[i].path)) continue;
   118	      int? faces;
   119	      try {
   120	        faces = (await state.engine.inspect(_inputs[i].path)).faces;
   121	      } catch (_) {
   122	        faces = null;
   123	      }
   124	      if (_disposed) return;
   125	      setState(() => _inputs[i] = _inputs[i].withFaces(faces));
   126	    }
   127	    _inspecting = false;
   128	    if (_disposed) return;
   129	    // Files added while the loop ran its last pass are picked up here.
   130	    if (_inputs.any((i) => !_inspected.contains(i.path))) return _inspectAll(state);
   131	    setState(() => _reading = false);
   132	  }
