   200	  void addHistory(HistoryEntry e) {
   201	    history = [e, ...history].take(HistoryStore.maxEntries).toList();
   202	    _history.save(history);
   203	    notifyListeners();
   204	  }
   205	
   206	  void deleteHistory(HistoryEntry e, {bool deleteFile = true}) {
   207	    history = history.where((h) => h.outputPath != e.outputPath).toList();
   208	    if (deleteFile) {
   209	      try {
   210	        File(e.outputPath).deleteSync();
   211	      } catch (_) {}
   212	    }
   213	    _history.save(history);
   214	    notifyListeners();
   215	  }
   216	
   217	  void clearHistory() {
   218	    for (final e in history) {
   219	      try {
   220	        File(e.outputPath).deleteSync();
   221	      } catch (_) {}
   222	    }
   223	    history = [];
   224	    _history.save(history);
   225	    notifyListeners();
   226	  }
