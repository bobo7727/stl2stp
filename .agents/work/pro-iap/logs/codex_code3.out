    30	/// Shows the system picker (STL only). Returns a local path or null.
    31	/// Desktop fallback: a path text field when the picker is unavailable
    32	/// (e.g. WSLg without an XDG desktop portal).
    33	Future<String?> pickStl(BuildContext context) async {
    34	  final s = S.of(context);
    35	  try {
    36	    final f = await FilePicker.pickFile(type: FileType.custom, allowedExtensions: const ['stl', 'STL']);
    37	    if (f == null) return null;
    38	    final path = f.path;
    39	    if (path != null) return path;
    40	    // Non-file URI (sandboxed platforms): copy into the app's temp dir.
    41	    final tmp = File(p.join(Directory.systemTemp.path, f.name));
    42	    await tmp.writeAsBytes(await f.readAsBytes(), flush: true);
    43	    return tmp.path;
    44	  } catch (e) {
    45	    debugPrint('file picker failed: $e');
    46	    if (!context.mounted) return null;
    47	    return askPath(context, s.t('x.open_path.picker_failed'));
    48	  }
    49	}
    50	
    51	/// Most files one batch may hold (PLAN §8.2).
    52	const maxBatchFiles = 50;
    53	
    54	/// FNV-1a over [bytes]; cheap content identity for picks that have no path.
    55	int _fnv(Uint8List bytes) {
    56	  var h = 0xcbf29ce484222325;
    57	  for (final b in bytes) {
    58	    h = ((h ^ b) * 0x100000001b3) & 0x7fffffffffffffff;
    59	  }
    60	  return h;
    61	}
    62	
    63	/// Turns picker results into local paths (see [pickStls]).
    64	@visibleForTesting
    65	Future<List<String>> materializePicked(List<PlatformFile> files, {Directory? tempRoot}) async {
    66	  final seen = <String>{};
    67	  final out = <String>[];
    68	  for (final f in files) {
    69	    final path = f.path;
    70	    if (path != null) {
    71	      if (seen.add('path:$path')) out.add(path);
    72	      continue;
    73	    }
    74	    final bytes = await f.readAsBytes();
    75	    if (!seen.add('data:${f.name}:${bytes.length}:${_fnv(bytes)}')) continue;
    76	    final dir = (tempRoot ?? Directory.systemTemp).createTempSync('stl2stp_batch_');
    77	    final tmp = File(p.join(dir.path, f.name));
    78	    await tmp.writeAsBytes(bytes, flush: true);
    79	    out.add(tmp.path);
    80	  }
    81	  return out;
    82	}
    83	
    84	/// Picks several STL files (PLAN §8.1, §14c P13). Every non-local result is
    85	/// copied into its own temp sub-directory under its original name, so equal
    86	/// names from different sources never collide. Duplicates are removed by
    87	/// source identity (local path, or name + size + content hash), never by the
    88	/// copied path. Returns an empty list when cancelled. Falls back to the path
    89	/// dialog (one file per call) when the picker is unavailable.
    90	Future<List<String>> pickStls(BuildContext context) async {
    91	  final s = S.of(context);
    92	  try {
    93	    final files = await FilePicker.pickFiles(type: FileType.custom, allowedExtensions: const ['stl', 'STL']);
    94	    final out = await materializePicked(files);
    95	    return out;
    96	  } catch (e) {
    97	    debugPrint('file picker failed: $e');
    98	    if (!context.mounted) return const [];
    99	    final one = await askPath(context, s.t('batch.picker_note'));
   100	    return one == null ? const [] : [one];
   101	  }
   102	}
