    43	  /// Does not open a library. Tests use this to stand in for a successful load.
    44	  @visibleForTesting
    45	  FfiEngine.testInstance() : libraryPath = null;
    46	
    47	  /// Path of the opened library, or null when linked into the process (iOS).
    48	  final String? libraryPath;
    49	
    50	  /// Reason [tryCreate] last returned null. Null after a successful load.
