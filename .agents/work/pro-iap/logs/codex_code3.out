     7	/// One file picked for a batch.
     8	class BatchInput {
     9	  const BatchInput({required this.path, required this.name, required this.size, this.faces});
    10	  final String path;
    11	  final String name;
    12	  final int size;
    13	
    14	  /// Face count from `inspect`; null = could not be read (not part of the run).
    15	  final int? faces;
    16	
    17	  BatchInput withFaces(int? f) => BatchInput(path: path, name: name, size: size, faces: f);
    18	}
    19	
    20	enum BatchItemState { waiting, running, done, failed, skipped, notRun }
    21	
    22	/// Why the queue stopped before every file was handled.
    23	enum BatchStopReason { cancelled, memory, background, entitlement }
    24	
    25	/// Mutable per-file status. Every item ends in exactly one terminal state
    26	/// (done / failed / skipped / notRun); see [BatchRunner].
    27	class BatchItem {
    28	  BatchItem(this.input);
    29	  final BatchInput input;
    30	  BatchItemState state = BatchItemState.waiting;
    31	
    32	  /// i18n key for the skip reason (skipped only).
    33	  String? reasonKey;
    34	
    35	  /// Why the queue stopped (notRun only).
    36	  BatchStopReason? stopReason;
    37	
    38	  /// Engine status and message (failed only).
    39	  int? status;
    40	  String message = '';
    41	  ConvertResult? result;
    42	  double progress = 0;
    43	  Stage? stage;
    44	
    45	  bool get isTerminal =>
    46	      state == BatchItemState.done ||
    47	      state == BatchItemState.failed ||
    48	      state == BatchItemState.skipped ||
    49	      state == BatchItemState.notRun;
    50	}
    51	
    52	class BatchSummary {
    53	  const BatchSummary(this.done, this.failed, this.skipped, this.notRun);
    54	  final int done, failed, skipped, notRun;
    55	  int get total => done + failed + skipped + notRun;
    56	}
    57	
    58	/// Sequential batch queue (PLAN §8.3, §14c P10/P14). Pure Dart, no UI.
    59	///
    60	/// - Files run one at a time (no stacked memory peaks).
    61	/// - A failing file is recorded and the queue continues.
    62	/// - [stop] ends the queue: the running file is cancelled and recorded as
    63	///   `notRun` with the reason, remaining files become `notRun`. If the engine
    64	///   already finished the running file successfully, it stays `done`.
    65	/// - Entitlement is re-checked between files ([isAllowed]); a revoked
    66	///   entitlement lets the current file finish and stops the queue.
    67	/// - Every item gets exactly one terminal state, so the summary total always
    68	///   equals the number of selected files.
    69	class BatchRunner extends ChangeNotifier {
    70	  BatchRunner({
    71	    required this.engine,
    72	    required List<BatchInput> inputs,
    73	    required this.settings,
    74	    required this.memoryGuard,
    75	    required this.budgetBytes,
    76	    required this.outputPathFor,
    77	    required this.onFileDone,
    78	    this.isAllowed,
    79	    this.maxFacesNow,
    80	    this.limitFaces = 2000000,
    81	  }) : items = [for (final i in inputs) BatchItem(i)];
    82	
    83	  final ConversionEngine engine;
    84	  final List<BatchItem> items;
    85	  final ConvertSettings settings;
    86	  final MemoryGuard memoryGuard;
    87	  final int budgetBytes;
    88	
    89	  /// Output path for a source file (must not collide with earlier outputs).
    90	  final String Function(String sourcePath, ExportFormat f) outputPathFor;
    91	
    92	  /// Called once for each successfully converted file (history, counters).
    93	  final void Function(BatchItem item, ConvertResult result) onFileDone;
    94	
    95	  /// False when Pro is no longer active. Null = always allowed.
    96	  final bool Function()? isAllowed;
    97	
    98	  /// Free-tier face limit to enforce on each file's real mesh right now (null = none).
    99	  final int? Function()? maxFacesNow;
   100	  final int limitFaces;
   101	
   102	  BatchStopReason? _stopReason;
   103	  CancelToken? _current;
   104	  int _index = -1;
   105	  bool _started = false;
   106	  bool _finished = false;
   107	
   108	  /// 0-based index of the file being processed, or -1.
   109	  int get currentIndex => _index;
   110	  bool get finished => _finished;
   111	  BatchStopReason? get stopReason => _stopReason;
   112	
   113	  BatchSummary get summary {
   114	    var d = 0, f = 0, s = 0, n = 0;
   115	    for (final i in items) {
   116	      switch (i.state) {
   117	        case BatchItemState.done:
   118	          d++;
   119	        case BatchItemState.failed:
   120	          f++;
   121	        case BatchItemState.skipped:
   122	          s++;
   123	        case BatchItemState.notRun:
   124	          n++;
   125	        case BatchItemState.waiting:
   126	        case BatchItemState.running:
   127	          break;
   128	      }
   129	    }
   130	    return BatchSummary(d, f, s, n);
   131	  }
   132	
   133	  /// Fraction of files that reached a terminal state, plus the running one's progress.
   134	  double get overall {
   135	    if (items.isEmpty) return 1;
   136	    var sum = 0.0;
   137	    for (final i in items) {
   138	      sum += i.isTerminal ? 1 : (i.state == BatchItemState.running ? i.progress : 0);
   139	    }
   140	    return sum / items.length;
   141	  }
   142	
   143	  bool _disposed = false;
   144	
   145	  @override
   146	  void notifyListeners() {
   147	    if (!_disposed) super.notifyListeners();
   148	  }
   149	
   150	  /// Safe while the queue is still running: later updates are dropped.
   151	  @override
   152	  void dispose() {
   153	    _disposed = true;
   154	    super.dispose();
   155	  }
   156	
   157	  /// Ends the queue for [reason]. The first reason wins.
   158	  void stop(BatchStopReason reason) {
   159	    if (_finished) return;
   160	    _stopReason ??= reason;
   161	    _current?.cancel();
   162	  }
   163	
   164	  void _terminal(BatchItem it, BatchItemState s) {
   165	    if (it.isTerminal) return; // exactly one terminal state per file
   166	    it.state = s;
   167	    notifyListeners();
   168	  }
   169	
   170	  Future<void> run() async {
   171	    assert(!_started, 'BatchRunner.run() may be called once');
   172	    if (_started) return;
   173	    _started = true;
   174	    try {
   175	      for (var i = 0; i < items.length; i++) {
   176	        final it = items[i];
   177	        _index = i;
   178	        if (_stopReason == null && isAllowed != null && !isAllowed!()) _stopReason = BatchStopReason.entitlement;
   179	        if (_stopReason != null) {
   180	          it.stopReason = _stopReason;
   181	          _terminal(it, BatchItemState.notRun);
   182	          continue;
   183	        }
   184	        final faces = it.input.faces;
   185	        if (faces == null) {
   186	          it.status = CoreStatus.errorFormat;
   187	          it.message = 'unreadable';
   188	          _terminal(it, BatchItemState.failed);
   189	          continue;
   190	        }
   191	        if (faces > limitFaces) {
   192	          it.reasonKey = 'batch.skip.faces';
   193	          _terminal(it, BatchItemState.skipped);
   194	          continue;
   195	        }
   196	        if (memoryGuard.check(faces, settings, budgetBytes).level == MemoryLevel.refuse) {
   197	          it.reasonKey = 'batch.skip.memory';
   198	          _terminal(it, BatchItemState.skipped);
   199	          continue;
   200	        }
   201	        try {
   202	          await _runOne(it, faces);
   203	        } catch (e) {
   204	          // Whatever went wrong, the file gets its one terminal state and the queue goes on.
   205	          it.status = CoreStatus.errorInternal;
   206	          it.message = '$e';
   207	          _terminal(it, BatchItemState.failed);
   208	        }
   209	      }
   210	    } finally {
   211	      // Even on an unexpected error the queue ends with every file in a terminal state.
   212	      for (final it in items) {
   213	        if (!it.isTerminal) {
   214	          it.stopReason ??= _stopReason ?? BatchStopReason.cancelled;
   215	          it.state = BatchItemState.notRun;
   216	        }
   217	      }
   218	      _index = -1;
   219	      _finished = true;
   220	      notifyListeners();
   221	    }
   222	  }
   223	
   224	  Future<void> _runOne(BatchItem it, int faces) async {
   225	    CancelToken? token;
   226	    it.state = BatchItemState.running;
   227	    notifyListeners();
   228	    try {
   229	      // Everything that can throw (output directory, token, engine) is inside this try.
   230	      final request = ConvertRequest(
   231	        inputPath: it.input.path,
   232	        outputPath: outputPathFor(it.input.path, settings.format),
   233	        settings: settings,
   234	        faces: faces,
   235	        maxFaces: maxFacesNow?.call(),
   236	      );
   237	      token = _current = engine.newCancelToken();
   238	      ConvertResult r;
   239	      try {
   240	        r = await engine.convert(request, cancel: token, onProgress: (p) {
   241	          it.stage = p.stage;
   242	          it.progress = p.overall;
   243	          notifyListeners();
   244	        });
   245	      } catch (e) {
   246	        r = ConvertResult(status: CoreStatus.errorInternal, outputPath: request.outputPath, message: '$e');
   247	      }
   248	      it.result = r;
   249	      if (r.ok) {
   250	        // A finished conversion stays done even if a stop arrived at the boundary.
   251	        try {
   252	          onFileDone(it, r);
   253	        } catch (e) {
   254	          debugPrint('batch onFileDone failed: $e');
   255	        }
   256	        _terminal(it, BatchItemState.done);
   257	      } else if (r.status == CoreStatus.errorCancelled) {
   258	        // A cancelled file always ends the queue, even if the engine reported it unprompted.
   259	        it.stopReason = _stopReason ??= BatchStopReason.cancelled;
   260	        _terminal(it, BatchItemState.notRun);
   261	      } else {
   262	        it.status = r.status;
   263	        it.message = r.message;
   264	        _terminal(it, BatchItemState.failed);
   265	      }
   266	    } finally {
   267	      token?.dispose();
   268	      _current = null;
   269	    }
   270	  }
   271	}

